[Version]
Signature   = "$Windows NT$"
Class       = Sample
ClassGuid   = {78A1C341-4539-11d3-B88D-00C04FAD5171}
Provider    = %ProviderName%
DriverVer   = 05/27/2026,1.0.0.0
CatalogFile = KmdfHelloIoctl.cat

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
KmdfHelloIoctl.sys = 1

[Manufacturer]
%ProviderName% = Standard,NT$ARCH$

[Standard.NT$ARCH$]
%DeviceDesc% = Install, Root\KmdfHelloIoctl

[Install]
CopyFiles = DriverCopyFiles

[DriverCopyFiles]
KmdfHelloIoctl.sys

[Install.Services]
AddService = KmdfHelloIoctl,0x00000002,ServiceInstall

[ServiceInstall]
DisplayName    = %ServiceName%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\KmdfHelloIoctl.sys

[Install.Wdf]
KmdfService = KmdfHelloIoctl, KmdfHelloIoctl_wdfsect

[KmdfHelloIoctl_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
ProviderName = "Contoso"
DiskName     = "KmdfHelloIoctl Installation Disk"
DeviceDesc   = "KMDF Hello IOCTL Device"
ServiceName  = "KMDF Hello IOCTL Service"
