<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>RevivalMain</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FluentIcons.Wpf" Version="2.1.328" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\\shared-fishing-runtime\\Fishing\Runtime\IOffsetsSource.cs" Link="LinkedRuntime\IOffsetsSource.cs" />
    <Compile Include="..\\shared-fishing-runtime\\Fishing\Runtime\OffsetsSourceProvider.cs" Link="LinkedRuntime\OffsetsSourceProvider.cs" />
    <Compile Include="..\\shared-fishing-runtime\\Fishing\Runtime\RobloxMemory.cs" Link="LinkedRuntime\RobloxMemory.cs" />
    <Compile Include="..\\shared-fishing-runtime\\Fishing\Runtime\FishingRuntimeContext.cs" Link="LinkedRuntime\FishingRuntimeContext.cs" />
    <Compile Include="..\\shared-fishing-runtime\\Fishing\Hotbar\HotbarRodReader.cs" Link="LinkedRuntime\HotbarRodReader.cs" />
    <Compile Include="..\\shared-fishing-runtime\\Fishing\Rod\HotbarRodResolver.cs" Link="LinkedRuntime\HotbarRodResolver.cs" />
    <Compile Include="..\\shared-fishing-runtime\\Fishing\Hotbar\HotbarSlotSettings.cs" Link="LinkedRuntime\HotbarSlotSettings.cs" />
    <Compile Include="..\\shared-fishing-runtime\\Fishing\Rod\NoteTarget.cs" Link="LinkedRuntime\NoteTarget.cs" />
    <Compile Include="..\\shared-fishing-runtime\\Fishing\Tracking1\Tracking1Controller.cs" Link="LinkedRuntime\Tracking1Controller.cs" />
    <Compile Include="..\\shared-fishing-runtime\\Fishing\Tracking1\Tracking1Settings.cs" Link="LinkedRuntime\Tracking1Settings.cs" />
    <Compile Include="..\\shared-fishing-runtime\\Fishing\Tracking2\Tracking2Controller.cs" Link="LinkedRuntime\Tracking2Controller.cs" />
    <Compile Include="..\\shared-fishing-runtime\\Fishing\Tracking2\Tracking2Settings.cs" Link="LinkedRuntime\Tracking2Settings.cs" />
    <Compile Include="..\\shared-fishing-runtime\\Fishing\Tracking3\Tracking3Controller.cs" Link="LinkedRuntime\Tracking3Controller.cs" />
    <Compile Include="..\\shared-fishing-runtime\\Fishing\Tracking3\Tracking3Decision.cs" Link="LinkedRuntime\Tracking3Decision.cs" />
    <Compile Include="..\\shared-fishing-runtime\\Fishing\Tracking3\Tracking3Settings.cs" Link="LinkedRuntime\Tracking3Settings.cs" />
    <Compile Include="..\\shared-fishing-runtime\\Fishing\Input\NativeMouse.cs" Link="LinkedRuntime\NativeMouse.cs" />
    <Compile Include="..\\shared-fishing-runtime\\Fishing\Rod\FishingHoldGate.cs" Link="LinkedRuntime\FishingHoldGate.cs" />
  </ItemGroup>

  <Target Name="CopyNativeCoreIpc" AfterTargets="Build">
    <ItemGroup>
      <NativeCoreIpc Include="..\\native-core\\build-vs\$(Configuration)\openmacro_core_ipc.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeCoreIpc)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(NativeCoreIpc.Identity)')" />
  </Target>

</Project>

