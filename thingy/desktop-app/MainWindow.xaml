<ui:FluentWindow x:Class="OpenMacroSwift.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:models="clr-namespace:OpenMacroSwift.Desktop.Models"
                 Title="OpenMacro Swift"
                 Width="1040"
                 Height="650"
                 MinWidth="900"
                 MinHeight="580"
                 Background="{StaticResource AppBackgroundBrush}"
                 Topmost="True"
                 Focusable="True"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type models:MacroModule}">
            <Border Style="{StaticResource SoftPanelBorder}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="22" Margin="0,2,14,0" Foreground="{StaticResource AccentBrush}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Status, StringFormat=Status: {0}}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                    </StackPanel>
                    <ToggleButton Grid.Column="2" Style="{StaticResource SwitchToggle}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                </Grid>
            </Border>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0E0E0E" Offset="0" />
                <GradientStop Color="#0E0E0E" Offset="0.45" />
                <GradientStop Color="#141414" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="OpenMacro Swift" ShowMaximize="True" ShowMinimize="True" ShowClose="True">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,142,0">
                    <TextBlock Text="{Binding RuntimeText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <Border Background="{StaticResource PanelElevatedBrush}" CornerRadius="11" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="{Binding UpdateStatusText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OffsetsText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding HotkeyText, StringFormat=Hotkey {0}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <Button Content="Start / Stop" Style="{StaticResource PrimaryButton}" Width="104" Command="{Binding ToggleMacroCommand}" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="3,3,3,12">
                        <TextBlock Text="OpenMacro" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource SidebarToggle}"
                                              IsChecked="{Binding IsSelected}"
                                              Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                              CommandParameter="{Binding}"
                                              Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="18" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel Visibility="{Binding IsGeneralVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="General" Style="{StaticResource PageTitleText}" />
                        <Grid Width="520" HorizontalAlignment="Left" Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Fishing Macro" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding StatusText}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Start / Stop" Style="{StaticResource PrimaryButton}" Command="{Binding ToggleMacroCommand}" />
                            <Rectangle Grid.Row="1" Grid.ColumnSpan="2" Fill="{StaticResource HairlineBrush}" Margin="0,18" />
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Hotkey" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding HotkeyText}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Row="2" Grid.Column="1" Content="Rebind" Style="{StaticResource SecondaryButton}" Command="{Binding RebindHotkeyCommand}" />
                            <Rectangle Grid.Row="3" Grid.ColumnSpan="2" Fill="{StaticResource HairlineBrush}" Margin="0,18" />
                            <StackPanel Grid.Row="4">
                                <TextBlock Text="Rod Location" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding SelectedRodSlot}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding RodSlots}" SelectedItem="{Binding SelectedRodSlot}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsFishingVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Fishing" Style="{StaticResource PageTitleText}" />
                        <Grid Margin="0,12,0,0" HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.ColumnSpan="3" Style="{StaticResource PanelBorder}">
                                <StackPanel>
                                    <TextBlock Text="Fishing Settings" Style="{StaticResource SectionTitleText}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tracking Method" Style="{StaticResource MutedText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding TrackerModes}" SelectedItem="{Binding SelectedTrackerMode}" />
                                        <TextBlock Grid.Row="2" Text="Casting" Style="{StaticResource MutedText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding CastingModes}" SelectedItem="{Binding SelectedCastingMode}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource PanelBorder}">
                                <StackPanel>
                                    <TextBlock Text="Current Rod / Input Status" Style="{StaticResource SectionTitleText}" />
                                    <Grid Margin="0,6,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Current Rod" Style="{StaticResource MutedText}" />
                                            <TextBlock Text="{Binding CurrentRodText}" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="Equipped" Style="{StaticResource MutedText}" Margin="0,12,0,0" />
                                            <TextBlock Text="{Binding EquippedStateText}" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource PanelBorder}">
                                <StackPanel>
                                    <TextBlock Text="Session Stats" Style="{StaticResource SectionTitleText}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Input" Style="{StaticResource MutedText}" />
                                            <TextBlock Text="{Binding InputStatusText}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Lost" Style="{StaticResource MutedText}" />
                                            <TextBlock Text="{Binding LostText}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2">
                                            <TextBlock Text="Success" Style="{StaticResource MutedText}" />
                                            <TextBlock Text="{Binding SuccessRateText}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="Progress" Style="{StaticResource MutedText}" />
                                            <TextBlock Text="{Binding ProgressText}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource PanelBorder}" Visibility="{Binding IsMasterlineRodSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Masterline Rods" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="{Binding MasterlineRodNamesText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <Grid Visibility="{Binding IsAddonsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Fishing Addons" Style="{StaticResource PageTitleText}" />
                            <Rectangle Height="8" Fill="Transparent" />
                            <ItemsControl ItemsSource="{Binding AddonModules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SecondaryButton}" Background="{StaticResource TableSurface}" BorderBrush="{StaticResource Border}" BorderThickness="1" MinHeight="36" Margin="0,0,0,6" Padding="10,0" Command="{Binding DataContext.SelectAddonCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Grid Grid.Column="1" Margin="12,0,0,0">
                            <StackPanel Visibility="{Binding IsAutoAquariumSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Auto Aquarium" Style="{StaticResource PageTitleText}" />
                                <Border Style="{StaticResource PanelBorder}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="Auto Aquarium" Style="{StaticResource SectionTitleText}" />
                                            </StackPanel>
                                            <ToggleButton HorizontalAlignment="Right" Style="{StaticResource SwitchToggle}" IsChecked="{Binding AutoAquariumEnabled}" />
                                        </Grid>
                                        <TextBlock Text="Cycle Delay (minutes)" Style="{StaticResource MutedText}" Margin="0,14,0,5" />
                                        <TextBox Text="{Binding AutoAquariumCycleDelayMinutes}" Width="150" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsAutoTotemSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Auto Totem" Style="{StaticResource PageTitleText}" />
                                <Border Style="{StaticResource PanelBorder}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Auto Totem" Style="{StaticResource SectionTitleText}" />
                                            <ToggleButton HorizontalAlignment="Right" Style="{StaticResource SwitchToggle}" IsChecked="{Binding AutoTotemEnabled}" />
                                        </Grid>
                                        <TextBlock Text="Totem" Style="{StaticResource MutedText}" />
                                        <ComboBox ItemsSource="{Binding TotemOptions}" SelectedItem="{Binding SelectedTotem}" Margin="0,5,0,10" />
                                        <TextBlock Text="Totem Effects" Style="{StaticResource MutedText}" />
                                        <UniformGrid Columns="3" Margin="0,5,0,10">
                                            <CheckBox Content="Use Shiny Totem" IsChecked="{Binding UseShinyTotem}" />
                                            <CheckBox Content="Use Sparkling Totem" IsChecked="{Binding UseSparklingTotem}" />
                                            <CheckBox Content="Use Mutation Totem" IsChecked="{Binding UseMutationTotem}" />
                                        </UniformGrid>
                                        <TextBlock Text="Cycle Lock" Style="{StaticResource MutedText}" />
                                        <UniformGrid Columns="2" Margin="0,5,0,10">
                                            <CheckBox Content="Stay Day" IsChecked="{Binding StayDay}" />
                                            <CheckBox Content="Stay Night" IsChecked="{Binding StayNight}" />
                                        </UniformGrid>
                                        <TextBlock Text="Status" Style="{StaticResource MutedText}" />
                                        <TextBlock Text="{Binding TotemStatusText}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsAutoSovereignRechargeSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Auto Sovereign Recharge" Style="{StaticResource PageTitleText}" />
                                <Border Style="{StaticResource PanelBorder}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Auto Sovereign Recharge" Style="{StaticResource SectionTitleText}" />
                                            <ToggleButton HorizontalAlignment="Right" Style="{StaticResource SwitchToggle}" IsChecked="{Binding AutoSovereignRechargeEnabled}" />
                                        </Grid>
                                        <UniformGrid Columns="2" Margin="0,0,0,10">
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="Min %" Style="{StaticResource MutedText}" />
                                                <TextBox Text="{Binding SovereignMinPercent}" Margin="0,6,0,0" />
                                            </StackPanel>
                                            <StackPanel Margin="8,0,0,0">
                                                <TextBlock Text="Max %" Style="{StaticResource MutedText}" />
                                                <TextBox Text="{Binding SovereignMaxPercent}" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="Status" Style="{StaticResource MutedText}" />
                                        <TextBlock Text="{Binding SovereignStatusText}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsHuntDetectAddonSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Hunt Detect" Style="{StaticResource PageTitleText}" />
                                <Border Style="{StaticResource PanelBorder}" Margin="0,10,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Hunt Detect" Style="{StaticResource SectionTitleText}" />
                                            <ToggleButton HorizontalAlignment="Right" Style="{StaticResource SwitchToggle}" IsChecked="{Binding HuntDetectEnabled}" />
                                        </Grid>
                                        <TextBlock Text="Discord Webhook" Style="{StaticResource MutedText}" />
                                        <TextBox Text="{Binding DiscordWebhook}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <Grid MinHeight="300">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource PanelBorder}">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding NewHuntTargetText}" />
                                                <Button Grid.Column="1" Content="Add" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding AddHuntTargetCommand}" />
                                            </Grid>
                                            <Grid Grid.Row="1" Margin="0,6,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding HuntSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Grid.Column="1" Content="Unselect all" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding ClearHuntsCommand}" />
                                            </Grid>
                                            <ScrollViewer Grid.Row="2">
                                                <ItemsControl ItemsSource="{Binding FilteredHuntTargets}">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,0,8,5" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource PanelBorder}" VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Text="Selected Targets" FontSize="16" FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{Binding SelectedHuntTargets}" Margin="0,12,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="10,7" Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="None Selected" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Visibility="{Binding IsAutomationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Other Automation" Style="{StaticResource PageTitleText}" />
                            <Rectangle Height="8" Fill="Transparent" />
                            <ItemsControl ItemsSource="{Binding AutomationModules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SecondaryButton}" Background="{StaticResource TableSurface}" BorderBrush="{StaticResource Border}" BorderThickness="1" MinHeight="36" Margin="0,0,0,6" Padding="10,0" Command="{Binding DataContext.SelectAutomationCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Grid Grid.Column="1" Margin="12,0,0,0">
                            <StackPanel Visibility="{Binding IsAutoAnglerSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Auto Angler" Style="{StaticResource PageTitleText}" />
                                <Border Style="{StaticResource PanelBorder}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <CheckBox Content="Auto Angler" IsChecked="{Binding AutoAnglerEnabled}" />
                                        <Button Content="Use Cursor" Style="{StaticResource SecondaryButton}" Width="108" Margin="0,8,0,0" Command="{Binding UseCursorPositionCommand}" />
                                    </StackPanel>
                                </Border>
                                <UniformGrid Columns="2" Margin="0,8,0,0">
                                    <Border Style="{StaticResource PanelBorder}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Current Fish" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding CurrentFishText}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel></Border>
                                    <Border Style="{StaticResource PanelBorder}" Margin="6,0,0,0"><StackPanel><TextBlock Text="Status" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding AutoAnglerStatusText}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel></Border>
                                </UniformGrid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsEnchantSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Enchant" Style="{StaticResource PageTitleText}" />
                                <Border Style="{StaticResource PanelBorder}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <CheckBox Content="Auto Enchant" IsChecked="{Binding AutoEnchantEnabled}" />
                                        <UniformGrid Columns="2" Margin="0,8,0,8">
                                            <RadioButton Content="Gamepass" GroupName="EnchantMode" IsChecked="{Binding IsEnchantGamepassMode}" />
                                            <RadioButton Content="Normal" GroupName="EnchantMode" />
                                        </UniformGrid>
                                        <TextBlock Text="Target Enchant" Style="{StaticResource MutedText}" />
                                        <TextBox Text="{Binding TargetSearchText}" Margin="0,5,0,6" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding EnchantTargets}" SelectedItem="{Binding SelectedTargetEnchant}" />
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBox Text="{Binding NewEnchantText}" />
                                                <Button Content="Add" Style="{StaticResource PrimaryButton}" Margin="0,6,0,0" Command="{Binding AddEnchantCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <UniformGrid Columns="3" Margin="0,8,0,0">
                                    <Border Style="{StaticResource PanelBorder}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Rod" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding EquippedRodText}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel></Border>
                                    <Border Style="{StaticResource PanelBorder}" Margin="6,0,6,0"><StackPanel><TextBlock Text="Current Enchant" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding CurrentEnchantText}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel></Border>
                                    <Border Style="{StaticResource PanelBorder}" Margin="6,0,0,0"><StackPanel><TextBlock Text="Status" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding EnchantStatusText}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel></Border>
                                </UniformGrid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsAppraiseSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Appraise" Style="{StaticResource PageTitleText}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Border Style="{StaticResource PanelBorder}">
                                            <StackPanel>
                                                <CheckBox Content="Auto Appraise" IsChecked="{Binding AutoAppraiseEnabled}" />
                                                <UniformGrid Columns="2" Margin="0,8,0,8">
                                                    <RadioButton Content="Gamepass" GroupName="AppraiseMode" IsChecked="{Binding IsAppraiseGamepassMode}" />
                                                    <RadioButton Content="Normal" GroupName="AppraiseMode" />
                                                </UniformGrid>
                                                <TextBlock Text="Slow / Fast" Style="{StaticResource MutedText}" />
                                                <Slider Minimum="0" Maximum="1" Value="{Binding GamepassSpeed}" />
                                                <Button Content="Use Cursor Position" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Command="{Binding UseCursorPositionCommand}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource PanelBorder}" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Required Traits" Style="{StaticResource MutedText}" />
                                                <UniformGrid Columns="3" Margin="0,6,0,0">
                                                    <CheckBox Content="Shiny" IsChecked="{Binding RequireShiny}" />
                                                    <CheckBox Content="Sparkling" IsChecked="{Binding RequireSparkling}" />
                                                    <CheckBox Content="Tiny" IsChecked="{Binding RequireTiny}" />
                                                    <CheckBox Content="Small" IsChecked="{Binding RequireSmall}" />
                                                    <CheckBox Content="Big" IsChecked="{Binding RequireBig}" />
                                                    <CheckBox Content="Giant" IsChecked="{Binding RequireGiant}" />
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Border Style="{StaticResource PanelBorder}">
                                            <StackPanel>
                                                <TextBlock Text="Base Mutations" Style="{StaticResource MutedText}" />
                                                <TextBox Text="{Binding MutationSearchText}" Margin="0,6,0,6" />
                                                <ComboBox ItemsSource="{Binding Mutations}" SelectedItem="{Binding SelectedMutation}" />
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding NewMutationText}" />
                                                    <Button Grid.Column="1" Content="Add" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Command="{Binding AddMutationCommand}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <UniformGrid Columns="2" Margin="0,8,0,0">
                                            <Border Style="{StaticResource PanelBorder}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Held Fish" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding AppraiseHeldFishText}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel></Border>
                                            <Border Style="{StaticResource PanelBorder}" Margin="6,0,0,0"><StackPanel><TextBlock Text="Status" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding AppraiseStatusText}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel></Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsTreasureSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Treasure Appraise" Style="{StaticResource PageTitleText}" />
                                <Border Style="{StaticResource PanelBorder}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <CheckBox Content="Auto Treasure" IsChecked="{Binding AutoTreasureEnabled}" />
                                        <UniformGrid Columns="2" Margin="0,8,0,0">
                                            <StackPanel Margin="0,0,8,0"><TextBlock Text="Click Delay (sec)" Style="{StaticResource MutedText}" /><TextBox Text="{Binding TreasureClickDelaySeconds}" Margin="0,6,0,0" /></StackPanel>
                                            <StackPanel Margin="8,0,0,0"><TextBlock Text="Minimum Multi" Style="{StaticResource MutedText}" /><TextBox Text="{Binding TreasureMinimumMulti}" Margin="0,6,0,0" /></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelBorder}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Status" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding TreasureStatusText}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel></Border>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <StackPanel Visibility="{Binding IsHuntDetectVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Hunt Detect" Style="{StaticResource PageTitleText}" />
                        <Border Style="{StaticResource PanelBorder}" Margin="0,18,0,12">
                            <StackPanel>
                                <TextBlock Text="Discord Webhook" Style="{StaticResource MutedText}" />
                                <TextBox Text="{Binding DiscordWebhook}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Grid MinHeight="420">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="0.95*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelBorder}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewHuntTargetText}" />
                                        <Button Grid.Column="1" Content="Add" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding AddHuntTargetCommand}" />
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,8,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding HuntSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" Content="Unselect all" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding ClearHuntsCommand}" />
                                    </Grid>
                                    <ScrollViewer Grid.Row="2">
                                        <ItemsControl ItemsSource="{Binding FilteredHuntTargets}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,0,10,8" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="Selected Targets" FontSize="16" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding SelectedHuntTargets}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="10,7" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsAccountVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Account" Style="{StaticResource PageTitleText}" />
                        <Border Style="{StaticResource PanelBorder}" Width="620" HorizontalAlignment="Left" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Profile" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{Binding DisplayName}" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Username}" Style="{StaticResource MutedText}" Margin="0,2,0,18" />
                                <TextBlock Text="Username" Style="{StaticResource MutedText}" />
                                <Grid Margin="0,6,0,18">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Username}" />
                                    <Button Grid.Column="1" Content="Save" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding SaveAccountCommand}" />
                                </Grid>
                                <TextBlock Text="Password" Style="{StaticResource MutedText}" />
                                <TextBox Text="{Binding CurrentPassword}" Margin="0,6,0,8" />
                                <TextBox Text="{Binding NewPassword}" Margin="0,0,0,8" />
                                <TextBox Text="{Binding ConfirmPassword}" Margin="0,0,0,12" />
                                <Button Content="Update Password" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Command="{Binding SaveAccountCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Settings" Style="{StaticResource PageTitleText}" />
                        <Border Style="{StaticResource PanelBorder}" Width="720" HorizontalAlignment="Left" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Client" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Theme" Style="{StaticResource MutedText}" />
                                <UniformGrid Columns="5" Margin="0,10,0,18">
                                    <RadioButton Content="Dark" GroupName="Theme" IsChecked="True" />
                                    <RadioButton Content="Light" GroupName="Theme" />
                                    <RadioButton Content="Slate" GroupName="Theme" />
                                    <RadioButton Content="Pink" GroupName="Theme" />
                                    <RadioButton Content="Custom" GroupName="Theme" />
                                </UniformGrid>
                                <TextBlock Text="Customize colors" Style="{StaticResource MutedText}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="Background" Style="{StaticResource MutedText}" />
                                    <TextBox Grid.Column="1" Text="{Binding BackgroundColor}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="1" Text="Surface" Style="{StaticResource MutedText}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SurfaceColor}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="2" Text="Border" Style="{StaticResource MutedText}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BorderColor}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="3" Text="Accent" Style="{StaticResource MutedText}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AccentColor}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="4" Text="Text" Style="{StaticResource MutedText}" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding TextColor}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="18,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding ActivityFeed}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,24,0" FontSize="12" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Grid.Column="1" Background="{StaticResource PanelElevatedBrush}" CornerRadius="10" Padding="12,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tracking" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding TrackingPhaseText}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
