<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Client.Controls"
             x:Class="Client.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <SolidColorBrush x:Key="Background" Color="#08090B" />
        <SolidColorBrush x:Key="Surface" Color="#131519" />
        <SolidColorBrush x:Key="Border" Color="#5F646C" />
        <SolidColorBrush x:Key="Accent" Color="#E7E9EC" />
        <SolidColorBrush x:Key="AccentHover" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentPressed" Color="#BFC3C9" />
        <SolidColorBrush x:Key="AccentForeground" Color="#090A0C" />
        <controls:ScaledPopupWidthConverter x:Key="ScaledPopupWidthConverter" Scale="1.18" />
        <Color x:Key="SystemAccentColor">#E7E9EC</Color>
        <Color x:Key="SystemAccentColorDark1">#D6D8DC</Color>
        <Color x:Key="SystemAccentColorDark2">#BFC3C9</Color>
        <Color x:Key="SystemAccentColorDark3">#A4A8B0</Color>
        <Color x:Key="SystemAccentColorLight1">#F1F3F5</Color>
        <Color x:Key="SystemAccentColorLight2">#F8F9FA</Color>
        <Color x:Key="SystemAccentColorLight3">#FFFFFF</Color>
        <SolidColorBrush x:Key="ThemeAccentColor" Color="#E7E9EC" />
        <SolidColorBrush x:Key="ThemeAccentBrush3" Color="#F1F3F5" />
        <SolidColorBrush x:Key="ThemeAccentBrush4" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#BFC3C9" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F5F5F6" />
        <SolidColorBrush x:Key="TextSecondary" Color="#A7AAB0" />
        <SolidColorBrush x:Key="PlaceholderForeground" Color="#7C838B" />
        <SolidColorBrush x:Key="Success" Color="#4ADE80" />
        <SolidColorBrush x:Key="Error" Color="#F87171" />
        <LinearGradientBrush x:Key="StarlightTruffleWormGradient" StartPoint="0%,50%" EndPoint="100%,50%">
            <GradientStop Color="#FF6AB7" Offset="0" />
            <GradientStop Color="#9CFF9A" Offset="0.52" />
            <GradientStop Color="#86B8FF" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="InputHoverSurface" Color="#202329" />
        <SolidColorBrush x:Key="InputHoverBorder" Color="#8D929A" />
        <SolidColorBrush x:Key="InputFocusSurface" Color="#181B20" />
        <SolidColorBrush x:Key="InputFocusBorder" Color="#F1F2F4" />
        <SolidColorBrush x:Key="TableSurface" Color="#101216" />
        <SolidColorBrush x:Key="TableRowBackground" Color="#101216" />
        <SolidColorBrush x:Key="TableGap" Color="#08090B" />
        <SolidColorBrush x:Key="TableHeaderBackground" Color="#1A1D22" />
        <SolidColorBrush x:Key="TableEmptyBackground" Color="#101216" />
        <SolidColorBrush x:Key="TableRowDisabled" Color="#101216" />
        <SolidColorBrush x:Key="SidebarItemForeground" Color="#A7AAB0" />
        <SolidColorBrush x:Key="SidebarItemHoverForeground" Color="#F5F5F6" />
        <SolidColorBrush x:Key="SidebarItemHoverBackground" Color="#202329" />
        <SolidColorBrush x:Key="SidebarItemSelectedForeground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SidebarItemSelectedBackground" Color="#4B4F56" />
        <SolidColorBrush x:Key="ButtonSecondaryBackground" Color="#00000000" />
        <SolidColorBrush x:Key="ButtonSecondaryForeground" Color="#E7E9EC" />
        <SolidColorBrush x:Key="ButtonSecondaryBorder" Color="#777C84" />
        <SolidColorBrush x:Key="ButtonSecondaryHoverBackground" Color="#202329" />
        <SolidColorBrush x:Key="ButtonSecondaryHoverBorder" Color="#F1F2F4" />
        <SolidColorBrush x:Key="ButtonSecondaryPressedBackground" Color="#191C21" />
        <SolidColorBrush x:Key="CheckboxBackground" Color="#131519" />
        <SolidColorBrush x:Key="CheckboxBorder" Color="#92969D" />
        <SolidColorBrush x:Key="CheckboxHoverBackground" Color="#202329" />
        <SolidColorBrush x:Key="CheckboxHoverBorder" Color="#F1F2F4" />
        <SolidColorBrush x:Key="CheckboxCheckedBackground" Color="#F1F2F4" />
        <SolidColorBrush x:Key="CheckboxCheckedBorder" Color="#F1F2F4" />
        <SolidColorBrush x:Key="CheckboxCheckForeground" Color="#0E0E0E" />
        <SolidColorBrush x:Key="CheckboxLabelForeground" Color="#F0F0F0" />
        <SolidColorBrush x:Key="CheckboxLabelHoverForeground" Color="#F0F0F0" />
        <SolidColorBrush x:Key="ThemeCardHoverBackground" Color="#202329" />
        <SolidColorBrush x:Key="ToggleHoverBackground" Color="#202329" />
        <SolidColorBrush x:Key="ToggleHoverBorder" Color="#777C84" />
        <SolidColorBrush x:Key="ToggleCheckedBackground" Color="#30343A" />
        <SolidColorBrush x:Key="ToggleCheckedBorder" Color="#C6C9CE" />
        <SolidColorBrush x:Key="ShellBackground" Color="#0C1016" />
        <SolidColorBrush x:Key="ShellOuterBorder" Color="#05070A" />
        <SolidColorBrush x:Key="ShellInnerBorder" Color="#7B8797" />
        <SolidColorBrush x:Key="ShellContentBackground" Color="#090D13" />
        <SolidColorBrush x:Key="ShellContentBorder" Color="#394555" />
        <SolidColorBrush x:Key="ShellNavBackground" Color="#0B1017" />
        <SolidColorBrush x:Key="ShellNavHoverBackground" Color="#151B23" />
        <SolidColorBrush x:Key="ShellNavHoverBorder" Color="#6D7581" />
        <SolidColorBrush x:Key="ShellNavSelectedBackground" Color="#283341" />
        <SolidColorBrush x:Key="ShellNavSelectedBorder" Color="#F5F8FC" />
        <SolidColorBrush x:Key="ShellNavGlow" Color="#50D8E3F0" />
        <SolidColorBrush x:Key="ShellChromeBackground" Color="#0D0F12" />
        <SolidColorBrush x:Key="ShellChromeBorder" Color="#373B42" />
        <SolidColorBrush x:Key="ShellShadow" Color="#40000000" />
        <SolidColorBrush x:Key="ShellSelectedShadow" Color="#60000000" />
        <FontFamily x:Key="DisplayFont">avares://Client/Assets/Fonts/Satoshi/OTF#Satoshi, Inter, Segoe UI, Arial</FontFamily>
        <FontFamily x:Key="UIFont">avares://Client/Assets/Fonts/Satoshi/OTF#Satoshi, Inter, Segoe UI, Arial</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Code, Consolas</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.app-card">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style Selector="Border.app-header">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
        </Style>

        <Style Selector="TextBlock.tab-title">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style Selector="TextBlock.tab-section-title">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style Selector="Border.app-header TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="Button.app-primary">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="{StaticResource AccentForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.app-primary /template/ ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="{StaticResource AccentForeground}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.app-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentHover}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource AccentForeground}" />
        </Style>

        <Style Selector="Button.app-primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentPressed}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource AccentForeground}" />
        </Style>

        <Style Selector="Button.app-secondary">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryBackground}" />
            <Setter Property="Foreground" Value="{StaticResource ButtonSecondaryForeground}" />
            <Setter Property="BorderBrush" Value="{StaticResource ButtonSecondaryBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.app-secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryHoverBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource ButtonSecondaryHoverBorder}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource ButtonSecondaryForeground}" />
        </Style>

        <Style Selector="Button.app-secondary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryPressedBackground}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource ButtonSecondaryForeground}" />
        </Style>

        <Style Selector="TextBox.app-input">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="PlaceholderForeground" Value="{StaticResource PlaceholderForeground}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="ComboBox.app-select">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="PlaceholderForeground" Value="{StaticResource PlaceholderForeground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="ComboBox.app-select:pointerover">
            <Setter Property="Background" Value="{StaticResource InputHoverSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputHoverBorder}" />
        </Style>

        <Style Selector="ComboBox.app-select:pointerover /template/ Border">
            <Setter Property="Background" Value="{StaticResource InputHoverSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputHoverBorder}" />
        </Style>

        <Style Selector="Button.app-nav">
            <Setter Property="Background" Value="{StaticResource TableSurface}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Path.app-nav-arrow">
            <Setter Property="Stroke" Value="{StaticResource TextSecondary}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Stroke" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.app-nav:pointerover Path.app-nav-arrow">
            <Setter Property="Stroke" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource CheckboxLabelForeground}" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Orientation="Horizontal"
                                Spacing="7"
                                VerticalAlignment="Center">
                        <Border Name="CheckBoxRoot"
                                Width="18"
                                Height="18"
                                Background="{StaticResource CheckboxBackground}"
                                BorderBrush="{StaticResource CheckboxBorder}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <Ellipse Name="CheckMark"
                                  IsVisible="False"
                                  Width="8"
                                  Height="8"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Fill="{StaticResource CheckboxCheckedBackground}" />
                        </Border>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="CheckBox:pointerover">
            <Setter Property="Foreground" Value="{StaticResource CheckboxLabelHoverForeground}" />
        </Style>

        <Style Selector="CheckBox:pointerover /template/ Border#CheckBoxRoot">
            <Setter Property="Background" Value="{StaticResource CheckboxHoverBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CheckboxHoverBorder}" />
        </Style>

        <Style Selector="CheckBox:checked /template/ Border#CheckBoxRoot">
            <Setter Property="BorderBrush" Value="{StaticResource CheckboxCheckedBorder}" />
        </Style>

        <Style Selector="CheckBox:checked /template/ Ellipse#CheckMark">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource CheckboxLabelForeground}" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Orientation="Horizontal"
                                Spacing="7"
                                VerticalAlignment="Center">
                        <Border Name="RadioRoot"
                                Width="18"
                                Height="18"
                                Background="{StaticResource CheckboxBackground}"
                                BorderBrush="{StaticResource CheckboxBorder}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <Ellipse Name="RadioMark"
                                     IsVisible="False"
                                     Width="8"
                                     Height="8"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource CheckboxCheckedBackground}" />
                        </Border>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RadioButton:pointerover /template/ Border#RadioRoot">
            <Setter Property="Background" Value="{StaticResource CheckboxHoverBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CheckboxHoverBorder}" />
        </Style>

        <Style Selector="RadioButton:checked /template/ Border#RadioRoot">
            <Setter Property="BorderBrush" Value="{StaticResource CheckboxCheckedBorder}" />
        </Style>

        <Style Selector="RadioButton:checked /template/ Ellipse#RadioMark">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="ToggleSwitch">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Grid Name="PART_MovingKnobs"
                              Width="38"
                              Height="20">
                            <Border Name="SwitchTrack"
                                    Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource CheckboxBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10" />
                            <Ellipse Name="SwitchThumb"
                                     Width="12"
                                     Height="12"
                                     Margin="4"
                                     HorizontalAlignment="Left"
                                     Fill="{StaticResource CheckboxBorder}" />
                        </Grid>
                        <TextBlock Name="SwitchState"
                                   Text="Off"
                                   VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ToggleSwitch:pointerover /template/ Border#SwitchTrack">
            <Setter Property="BorderBrush" Value="{StaticResource CheckboxHoverBorder}" />
        </Style>

        <Style Selector="ToggleSwitch:checked /template/ Border#SwitchTrack">
            <Setter Property="Background" Value="{StaticResource CheckboxCheckedBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CheckboxCheckedBorder}" />
        </Style>

        <Style Selector="ToggleSwitch:checked /template/ Ellipse#SwitchThumb">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Fill" Value="{StaticResource CheckboxCheckForeground}" />
        </Style>

        <Style Selector="ToggleSwitch:checked /template/ TextBlock#SwitchState">
            <Setter Property="Text" Value="On" />
        </Style>

        <Style Selector="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Track Name="PART_Track"
                           Height="4"
                           VerticalAlignment="Center"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_DecreaseButton"
                                          Background="{DynamicResource Accent}"
                                          BorderThickness="0">
                                <RepeatButton.Template>
                                    <ControlTemplate>
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="2" />
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.DecreaseButton>
                        <Track.Thumb>
                            <Thumb Width="18"
                                   Height="18"
                                   Background="{DynamicResource Accent}"
                                   BorderBrush="{DynamicResource AccentHover}"
                                   BorderThickness="1">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Ellipse Fill="{TemplateBinding Background}"
                                                 Stroke="{TemplateBinding BorderBrush}"
                                                 StrokeThickness="{TemplateBinding BorderThickness}" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_IncreaseButton"
                                          Background="{DynamicResource Border}"
                                          BorderThickness="0">
                                <RepeatButton.Template>
                                    <ControlTemplate>
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="2" />
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.IncreaseButton>
                    </Track>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Slider /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
        </Style>

        <Style Selector="Slider:pointerover /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="{DynamicResource AccentHover}" />
        </Style>

        <Style Selector="Slider /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Background" Value="{DynamicResource Border}" />
        </Style>

        <Style Selector="Slider /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource InputHoverSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputHoverBorder}" />
        </Style>

        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource InputFocusSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputFocusBorder}" />
        </Style>


        <Style Selector="controls|AppTable">
            <Setter Property="MinHeight" Value="96" />
        </Style>

        <Style Selector="controls|AppKeyValueList">
            <Setter Property="MinHeight" Value="42" />
        </Style>
    </Application.Styles>
</Application>
