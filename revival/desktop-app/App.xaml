<Application x:Class="OpenMacroSwift.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Theme/Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Wpf.Ui.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <SolidColorBrush x:Key="Background" Color="#0E0E0E" />
        <SolidColorBrush x:Key="Surface" Color="#161616" />
        <SolidColorBrush x:Key="Border" Color="#2A2A2A" />
        <SolidColorBrush x:Key="Accent" Color="#A9CFCB" />
        <SolidColorBrush x:Key="AccentHover" Color="#8FBFBB" />
        <SolidColorBrush x:Key="AccentPressed" Color="#789F9B" />
        <SolidColorBrush x:Key="AccentForeground" Color="#0E0E0E" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F0F0" />
        <SolidColorBrush x:Key="TextSecondary" Color="#666666" />
        <SolidColorBrush x:Key="Success" Color="#4ADE80" />
        <SolidColorBrush x:Key="Error" Color="#F87171" />
        <SolidColorBrush x:Key="InputHoverSurface" Color="#1A1A1A" />
        <SolidColorBrush x:Key="InputHoverBorder" Color="#3A3A3A" />
        <SolidColorBrush x:Key="InputFocusSurface" Color="#181818" />
        <SolidColorBrush x:Key="InputFocusBorder" Color="#5F8581" />
        <SolidColorBrush x:Key="TableSurface" Color="#141414" />
        <SolidColorBrush x:Key="TableRowBackground" Color="#141414" />
        <SolidColorBrush x:Key="TableGap" Color="#0E0E0E" />
        <SolidColorBrush x:Key="TableHeaderBackground" Color="#1B1B1B" />
        <SolidColorBrush x:Key="TableEmptyBackground" Color="#141414" />
        <SolidColorBrush x:Key="TableRowDisabled" Color="#141414" />
        <SolidColorBrush x:Key="SidebarItemForeground" Color="#666666" />
        <SolidColorBrush x:Key="SidebarItemHoverForeground" Color="#F0F0F0" />
        <SolidColorBrush x:Key="SidebarItemHoverBackground" Color="#1D1F1F" />
        <SolidColorBrush x:Key="SidebarItemSelectedForeground" Color="#F0F0F0" />
        <SolidColorBrush x:Key="SidebarItemSelectedBackground" Color="#242424" />
        <SolidColorBrush x:Key="ButtonSecondaryBackground" Color="#00000000" />
        <SolidColorBrush x:Key="ButtonSecondaryForeground" Color="#F0F0F0" />
        <SolidColorBrush x:Key="ButtonSecondaryBorder" Color="#2A2A2A" />
        <SolidColorBrush x:Key="ButtonSecondaryHoverBackground" Color="#1A1A1A" />
        <SolidColorBrush x:Key="ButtonSecondaryHoverBorder" Color="#3A3A3A" />
        <SolidColorBrush x:Key="ButtonSecondaryPressedBackground" Color="#181818" />
        <SolidColorBrush x:Key="CheckboxBackground" Color="#161616" />
        <SolidColorBrush x:Key="CheckboxBorder" Color="#666666" />
        <SolidColorBrush x:Key="CheckboxHoverBackground" Color="#1A1A1A" />
        <SolidColorBrush x:Key="CheckboxHoverBorder" Color="#A9CFCB" />
        <SolidColorBrush x:Key="CheckboxCheckedBackground" Color="#A9CFCB" />
        <SolidColorBrush x:Key="CheckboxCheckedBorder" Color="#A9CFCB" />
        <SolidColorBrush x:Key="CheckboxCheckForeground" Color="#0E0E0E" />
        <SolidColorBrush x:Key="CheckboxLabelForeground" Color="#F0F0F0" />
        <SolidColorBrush x:Key="CheckboxLabelHoverForeground" Color="#F0F0F0" />
        <SolidColorBrush x:Key="UpdateBannerBackground" Color="#0F1D1C" />
        <SolidColorBrush x:Key="ThemeCardHoverBackground" Color="#1A1A1A" />
        <SolidColorBrush x:Key="ToggleHoverBackground" Color="#141A20" />
        <SolidColorBrush x:Key="ToggleHoverBorder" Color="#273849" />
        <SolidColorBrush x:Key="ToggleCheckedBackground" Color="#121C26" />
        <SolidColorBrush x:Key="ToggleCheckedBorder" Color="#3A566F" />

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0E0E0E" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#0E0E0E" />
        <SolidColorBrush x:Key="PanelBrush" Color="#161616" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#141414" />
        <SolidColorBrush x:Key="PanelElevatedBrush" Color="#1B1B1B" />
        <SolidColorBrush x:Key="HoverBrush" Color="#1D1F1F" />
        <SolidColorBrush x:Key="SelectedBrush" Color="#242424" />
        <SolidColorBrush x:Key="HairlineBrush" Color="#2A2A2A" />
        <SolidColorBrush x:Key="TextBrush" Color="#F0F0F0" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#666666" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#666666" />
        <SolidColorBrush x:Key="AccentBrush" Color="#A9CFCB" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#8FBFBB" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#789F9B" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#0E0E0E" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
        <SolidColorBrush x:Key="WarningBrush" Color="#FFF0AA" />
        <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />

        <DropShadowEffect x:Key="PanelShadow"
                          BlurRadius="8"
                          ShadowDepth="1"
                          Direction="270"
                          Opacity="0.12"
                          Color="#000000" />

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        </Style>

        <Style x:Key="MutedText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="PageTitleText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SectionTitleText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="PanelBorder" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Effect" Value="{StaticResource PanelShadow}" />
        </Style>

        <Style x:Key="SoftPanelBorder" TargetType="{x:Type Border}" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{StaticResource ButtonSecondaryForeground}" />
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource ButtonSecondaryBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ButtonSecondaryHoverBackground}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ButtonSecondaryHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ButtonSecondaryPressedBackground}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ButtonSecondaryHoverBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SidebarItemForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9">
                            <Grid>
                                <Border x:Name="Rail"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,10"
                                        CornerRadius="2"
                                        Background="Transparent" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SidebarItemHoverBackground}" />
                                <Setter Property="Foreground" Value="{StaticResource SidebarItemHoverForeground}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SidebarItemSelectedBackground}" />
                                <Setter TargetName="Rail" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource SidebarItemSelectedForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource InputHoverSurface}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource InputHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource InputFocusSurface}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource InputFocusBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwitchToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="22" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Track"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11">
                            <Ellipse x:Name="Thumb"
                                     Width="16"
                                     Height="16"
                                     Margin="3"
                                     Fill="{StaticResource TextSecondary}"
                                     HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource ToggleHoverBackground}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource ToggleHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource ToggleCheckedBackground}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource ToggleCheckedBorder}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderThickness="0">
                                <Border x:Name="Chrome"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
                                    <Grid>
                                        <ContentPresenter x:Name="ContentSite"
                                                          Margin="9,0,28,0"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                        <Path HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"
                                              Fill="{StaticResource MutedTextBrush}"
                                              Data="M 0 0 L 8 0 L 4 5 Z" />
                                    </Grid>
                                </Border>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource Surface}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        Padding="4">
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="ToggleButton" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource InputHoverSurface}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource InputHoverBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemRoot" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource InputHoverSurface}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource CheckboxLabelForeground}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,8,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="13"
                                    Height="13"
                                    Background="{StaticResource CheckboxBackground}"
                                    BorderBrush="{StaticResource CheckboxBorder}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    VerticalAlignment="Center">
                                <Path x:Name="Mark"
                                      Data="M 2 6 L 5 9 L 11 3"
                                      Stroke="{StaticResource CheckboxCheckForeground}"
                                      StrokeThickness="1.8"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="6,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource CheckboxHoverBackground}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource CheckboxHoverBorder}" />
                                <Setter Property="Foreground" Value="{StaticResource CheckboxLabelHoverForeground}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource CheckboxCheckedBackground}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource CheckboxCheckedBorder}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{StaticResource CheckboxLabelForeground}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,8,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Ring"
                                    Width="13"
                                    Height="13"
                                    Background="{StaticResource CheckboxBackground}"
                                    BorderBrush="{StaticResource CheckboxBorder}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="Dot"
                                         Width="7"
                                         Height="7"
                                         Fill="{StaticResource AccentForeground}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="6,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Background" Value="{StaticResource CheckboxHoverBackground}" />
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource CheckboxHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Background" Value="{StaticResource CheckboxCheckedBackground}" />
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource CheckboxCheckedBorder}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Slider}">
            <Setter Property="MinHeight" Value="22" />
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

