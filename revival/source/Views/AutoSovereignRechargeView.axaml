<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Client.ViewModels"
             x:Class="Client.Views.AutoSovereignRechargeView"
             x:DataType="vm:AutoSovereignRechargeViewModel"
             Background="{StaticResource Background}">
    <Grid Margin="34,0,34,34"
          RowDefinitions="Auto,*"
          RowSpacing="12">
        <Border Grid.Row="0"
                Classes="app-card">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="14">
                <StackPanel Spacing="8">
                    <TextBlock Text="Auto Sovereign Recharge"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="{Binding StatusText}"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}" />
                </StackPanel>

                <CheckBox Grid.Column="1"
                          Content="Enabled"
                          IsChecked="{Binding Enabled}"
                          VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Classes="app-card">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Minimum percent"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBox Classes="app-input"
                                 Width="120"
                                 Height="36"
                                 Text="{Binding MinimumPercentText}" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Maximum percent"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBox Classes="app-input"
                                 Width="120"
                                 Height="36"
                                 Text="{Binding MaximumPercentText}" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Current power"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="{Binding CurrentPowerText}"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="18"
                                   Foreground="{StaticResource TextPrimary}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="The recharge helper reads the power meter and respects the current fishing loop."
                           FontFamily="{StaticResource UIFont}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
