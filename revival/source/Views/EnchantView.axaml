<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Client.ViewModels"
             xmlns:controls="using:Client.Controls"
             x:Class="Client.Views.EnchantView"
             x:DataType="vm:EnchantViewModel"
             Background="{StaticResource Background}">
    <Grid Margin="34,0,34,34"
          RowDefinitions="Auto,*"
          RowSpacing="12">
        <Border Grid.Row="0"
                Classes="app-card">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="14">
                <StackPanel Spacing="8">
                    <TextBlock Text="Enchant"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="{Binding StatusText}"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <Button Classes="app-primary"
                            Content="Start"
                            Command="{Binding StartCommand}"
                            Width="96"
                            Height="36" />
                    <Button Classes="app-secondary"
                            Content="Stop"
                            Command="{Binding StopCommand}"
                            Width="96"
                            Height="36" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="12">
            <StackPanel Spacing="12">
                <Border Classes="app-card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Target enchant"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" />
                        <ComboBox Classes="app-select"
                                  ItemsSource="{Binding TargetEnchants}"
                                  SelectedItem="{Binding SelectedTargetEnchant}"
                                  Height="38">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:EnchantOptionViewModel">
                                    <TextBlock Text="{Binding Name}"
                                               FontFamily="{StaticResource UIFont}"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimary}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox Classes="app-input"
                                     Width="200"
                                     Height="36"
                                     Text="{Binding TargetSearchText}" />
                            <TextBox Classes="app-input"
                                     Width="170"
                                     Height="36"
                                     Text="{Binding NewEnchantText}" />
                            <Button Classes="app-secondary"
                                    Content="Add"
                                    Command="{Binding AddEnchantCommand}"
                                    Width="80"
                                    Height="36" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="app-card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Mode"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <RadioButton Content="Gamepass"
                                         IsChecked="{Binding IsGamepassMode}" />
                            <RadioButton Content="Normal"
                                         IsChecked="{Binding IsNormalMode}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="12">
                <Border Classes="app-card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Rod"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" />
                        <controls:ColoredTextBlock Lines="{Binding EquippedRodLines}"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <Border Classes="app-card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Current enchant"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" />
                        <controls:ColoredTextBlock Lines="{Binding CurrentEnchantLines}"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <Border Classes="app-card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Status"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" />
                        <controls:ColoredTextBlock Lines="{Binding StatusLines}"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
