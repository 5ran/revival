<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Client.ViewModels"
             x:Class="Client.Views.HuntDetectView"
             x:Name="Root"
             x:DataType="vm:HuntDetectViewModel"
             Focusable="True"
             PointerPressed="OnRootPointerPressed"
             Background="{StaticResource Background}">
    <UserControl.Styles>
        <Style Selector="Border.hunt-action-field">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="TextBox.hunt-action-input">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6,0,0,6" />
        </Style>
        <Style Selector="Button.hunt-action-button">
            <Setter Property="CornerRadius" Value="0,5,5,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.hunt-action-primary /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.hunt-action-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentHover}" />
        </Style>
        <Style Selector="Button.hunt-action-primary:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentHover}" />
        </Style>
        <Style Selector="Button.hunt-action-primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentPressed}" />
        </Style>
        <Style Selector="Button.hunt-action-primary:pressed">
            <Setter Property="Background" Value="{StaticResource AccentPressed}" />
        </Style>
        <Style Selector="Button.hunt-action-secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryHoverBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource ButtonSecondaryHoverBorder}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource ButtonSecondaryForeground}" />
        </Style>
        <Style Selector="Button.hunt-action-secondary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryPressedBackground}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource ButtonSecondaryForeground}" />
        </Style>
        <Style Selector="ToggleButton.hunt-target">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Width" Value="165" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="ToggleButton.hunt-target:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryHoverBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource ButtonSecondaryHoverBorder}" />
        </Style>
        <Style Selector="ToggleButton.hunt-target:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ToggleCheckedBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource ToggleCheckedBorder}" />
        </Style>
    </UserControl.Styles>

    <Border Classes="app-card"
            Width="565"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="0,10"
            Padding="0">
        <Grid RowDefinitions="52,8,56,8,46,8,142,8,Auto">
            <Grid Grid.Row="0"
                  ColumnDefinitions="145,12,1,12,170,12,1,12,145"
                  HorizontalAlignment="Center"
                  Margin="16,8">
                <StackPanel Grid.Column="0"
                            Spacing="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Webhook"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="Discord"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />
                </StackPanel>

                <Border Grid.Column="2"
                        Background="{StaticResource Border}" />

                <CheckBox Grid.Column="4"
                          IsChecked="{Binding Enabled}"
                          Content="Hunt Detect"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          FontFamily="{StaticResource UIFont}"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextPrimary}" />

                <Border Grid.Column="6"
                        Background="{StaticResource Border}" />

                <StackPanel Grid.Column="8"
                            Spacing="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Selected"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding SelectedSummary}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Margin="18,3"
                    Height="1"
                    VerticalAlignment="Center"
                    Background="{StaticResource Border}" />

            <StackPanel Grid.Row="2"
                        Margin="20,1,20,5"
                        Spacing="4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                <TextBlock Text="Webhook"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontFamily="{StaticResource UIFont}"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondary}" />
                <TextBox Classes="app-input"
                         Height="30"
                         Text="{Binding DiscordWebhook}"
                         PlaceholderText="https://discord.com/api/webhooks/..." />
            </StackPanel>

            <Border Grid.Row="3"
                    Margin="18,3"
                    Height="1"
                    VerticalAlignment="Center"
                    Background="{StaticResource Border}" />

            <Grid Grid.Row="4"
                  Margin="20,4"
                  ColumnDefinitions="*,12,*"
                  ColumnSpacing="0"
                  VerticalAlignment="Center">
                <Border Grid.Column="0"
                        Classes="hunt-action-field"
                        Height="34">
                    <Grid ColumnDefinitions="*,62">
                        <TextBox Grid.Column="0"
                                 Classes="app-input hunt-action-input"
                                 Height="34"
                                 Text="{Binding SearchText}"
                                 PlaceholderText="Search targets" />
                        <Button Grid.Column="1"
                                Classes="app-primary hunt-action-button hunt-action-primary"
                                Height="34"
                                Content="Clear All"
                                Command="{Binding UnselectAllCommand}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Classes="hunt-action-field"
                        Height="34"
                        Margin="12,0,0,0">
                    <Grid ColumnDefinitions="*,42">
                        <TextBox Grid.Column="0"
                                 Classes="app-input hunt-action-input"
                                 Height="34"
                                 Text="{Binding NewTargetText}"
                                 PlaceholderText="New hunt name" />
                        <Button Grid.Column="1"
                                Classes="app-primary hunt-action-button hunt-action-primary"
                                Height="34"
                                Content="Add"
                                Command="{Binding AddTargetCommand}" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="5"
                    Margin="18,3"
                    Height="1"
                    VerticalAlignment="Center"
                    Background="{StaticResource Border}" />

            <ScrollViewer Grid.Row="6"
                          Margin="20,8"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding AvailableTargets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HuntDetectTargetOptionViewModel">
                            <ToggleButton Classes="hunt-target"
                                          Margin="0,0,8,8"
                                          IsChecked="{Binding IsSelected}"
                                          ToolTip.Tip="{Binding Name}">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{Binding Brush}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="7"
                    Margin="18,3"
                    Height="1"
                    VerticalAlignment="Center"
                    Background="{StaticResource Border}" />

            <Grid Grid.Row="8"
                  Margin="20,4,20,6"
                  RowDefinitions="Auto,3,Auto">
                <TextBlock Grid.Row="0"
                           Text="Selected Hunts"
                           Classes="tab-section-title" />

                <TextBlock Grid.Row="2"
                           Text="None Selected"
                           IsVisible="{Binding ShowEmptySelectedState}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource UIFont}"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondary}" />

                <ScrollViewer Grid.Row="2"
                              IsVisible="{Binding HasSelectedTargets}"
                              HorizontalAlignment="Center"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SelectedTargets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HuntDetectSelectedTargetViewModel">
                                <Grid ColumnDefinitions="Auto,18"
                                      Margin="0,0,10,1"
                                      VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               FontFamily="{StaticResource UIFont}"
                                               FontSize="11"
                                               Foreground="{Binding Brush}"
                                               VerticalAlignment="Center"
                                               ToolTip.Tip="{Binding Name}" />
                                    <Button Grid.Column="1"
                                            Classes="app-secondary"
                                            Width="14"
                                            Height="14"
                                            Margin="4,0,0,0"
                                            Padding="0"
                                            FontSize="9"
                                            Content="x"
                                            Command="{Binding #Root.DataContext.RemoveSelectedTargetCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
