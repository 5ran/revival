<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Client.ViewModels"
             x:Class="Client.Views.FishingAddonsView"
             x:DataType="vm:FishingAddonsViewModel"
             Background="{StaticResource Background}">
    <ScrollViewer Margin="0"
                  VerticalContentAlignment="Center"
                  VerticalScrollBarVisibility="Disabled">
        <StackPanel Spacing="6"
                    Margin="14,0,14,10"
                    VerticalAlignment="Center">
            <StackPanel Spacing="4"
                        Margin="0">
                <StackPanel.Styles>
                    <Style Selector="Border.totem-picker">
                        <Setter Property="Background" Value="{StaticResource TableSurface}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="ClipToBounds" Value="True" />
                    </Style>
                    <Style Selector="Button.totem-picker-button">
                        <Setter Property="Background" Value="{StaticResource Accent}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                        <Setter Property="BorderThickness" Value="1,0,0,0" />
                        <Setter Property="CornerRadius" Value="0,8,8,0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="VerticalAlignment" Value="Stretch" />
                        <Setter Property="ClipToBounds" Value="True" />
                        <Setter Property="Template">
                            <ControlTemplate>
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                            </ControlTemplate>
                        </Setter>
                    </Style>
                    <Style Selector="Border.totem-dropdown-surface">
                        <Setter Property="Background" Value="{StaticResource TableSurface}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="Padding" Value="6" />
                    </Style>
                    <Style Selector="Button.totem-picker-button /template/ ContentPresenter">
                        <Setter Property="Transitions">
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.12" />
                            </Transitions>
                        </Setter>
                    </Style>
                    <Style Selector="Button.totem-picker-button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{StaticResource AccentHover}" />
                        <Setter Property="BorderBrush" Value="{StaticResource AccentHover}" />
                    </Style>
                    <Style Selector="Button.totem-picker-button:pointerover">
                        <Setter Property="Background" Value="{StaticResource AccentHover}" />
                        <Setter Property="BorderBrush" Value="{StaticResource AccentHover}" />
                    </Style>
                    <Style Selector="Button.totem-picker-button:pressed /template/ ContentPresenter">
                        <Setter Property="Background" Value="{StaticResource AccentPressed}" />
                        <Setter Property="BorderBrush" Value="{StaticResource AccentPressed}" />
                    </Style>
                    <Style Selector="Button.totem-picker-button:pressed">
                        <Setter Property="Background" Value="{StaticResource AccentPressed}" />
                        <Setter Property="BorderBrush" Value="{StaticResource AccentPressed}" />
                    </Style>
                    <Style Selector="ListBox.totem-dropdown">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                    <Style Selector="ListBox.totem-dropdown ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                    <Style Selector="ListBox.totem-dropdown ListBoxItem /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                    <Style Selector="ListBox.totem-dropdown ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{StaticResource InputHoverSurface}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                    </Style>
                    <Style Selector="ListBox.totem-dropdown ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="{StaticResource ToggleCheckedBackground}" />
                        <Setter Property="BorderBrush" Value="{StaticResource ToggleCheckedBorder}" />
                    </Style>
                    <Style Selector="TextBlock.totem-picker-primary">
                        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
                        <Setter Property="FontSize" Value="13" />
                    </Style>
                    <Style Selector="TextBlock.totem-picker-suffix">
                        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                    </Style>
                    <Style Selector="CheckBox.auto-totem-option">
                        <Setter Property="HorizontalAlignment" Value="Center" />
                    </Style>
                    <Style Selector="CheckBox.addon-power-toggle">
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                    </Style>
                </StackPanel.Styles>
                <TextBlock Text="Automation Settings"
                           Classes="tab-section-title"
                           Margin="0,0,0,0" />

                <Grid Width="560"
                      RowDefinitions="Auto,8,Auto"
                      HorizontalAlignment="Center">
                    <Border Grid.Row="0"
                            Classes="app-header"
                            Width="560"
                            Padding="16,12">
                        <Grid RowDefinitions="20,6,14,6,30,8,1,14,48"
                              Width="430"
                              HorizontalAlignment="Center">
                            <CheckBox Grid.Row="0"
                                      Classes="addon-power-toggle"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Content="Auto Totem"
                                      IsChecked="{Binding AutoTotemEnabled}"
                                      FontFamily="{StaticResource DisplayFont}"
                                      FontSize="13" />

                            <Grid Grid.Row="2"
                                  Grid.RowSpan="3"
                                  ColumnDefinitions="168,32,168"
                                  Width="368"
                                  HorizontalAlignment="Center">
                                <StackPanel Grid.Column="0"
                                            Width="168"
                                            Spacing="6"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="Weather"
                                               Width="168"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="NoWrap"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondary}" />
                                    <Panel Width="168">
                                        <Border x:Name="PrimaryTotemPicker"
                                                Classes="totem-picker"
                                                Height="30"
                                                HorizontalAlignment="Stretch">
                                            <Grid ColumnDefinitions="*,34">
                                                <Border x:Name="PrimaryTotemField"
                                                        Grid.Column="0"
                                                        Background="Transparent"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        Margin="0,0,-1,0">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="0"
                                                                Margin="12,0,0,0"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AutoTotem.SelectedTotem.DisplayPrimary}"
                                                                   Classes="totem-picker-primary"
                                                                   Foreground="{Binding AutoTotem.SelectedTotem.Brush}" />
                                                        <TextBlock Text="{Binding AutoTotem.SelectedTotem.DisplaySuffix}"
                                                                   Classes="totem-picker-suffix" />
                                                    </StackPanel>
                                                </Border>
                                                <Button Grid.Column="1"
                                                        x:Name="PrimaryTotemDropdownButton"
                                                        Classes="totem-picker-button"
                                                        Click="PrimaryTotemDropdownButton_OnClick">
                                                    <Path Width="10"
                                                          Height="6"
                                                          Stretch="Fill"
                                                          Fill="{StaticResource AccentForeground}"
                                                          Data="M 0 0 L 5 6 L 10 0 Z" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <Popup x:Name="PrimaryTotemDropdownPopup"
                                               PlacementTarget="{Binding #PrimaryTotemPicker}"
                                               Placement="AnchorAndGravity"
                                               PlacementAnchor="BottomLeft"
                                               PlacementGravity="BottomRight"
                                               IsLightDismissEnabled="True">
                                            <Border x:Name="PrimaryTotemDropdownBorder"
                                                    Classes="totem-dropdown-surface"
                                                    Width="{Binding #PrimaryTotemPicker.Bounds.Width, Converter={StaticResource ScaledPopupWidthConverter}}"
                                                    Margin="0,4,0,0">
                                                <ScrollViewer MaxHeight="220"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <ListBox Classes="totem-dropdown"
                                                             ItemsSource="{Binding AutoTotem.PrimaryTotemOptions}"
                                                             SelectedItem="{Binding AutoTotem.SelectedTotem}"
                                                             SelectionChanged="PrimaryTotemList_OnSelectionChanged">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:TotemOptionViewModel">
                                                                <StackPanel Orientation="Horizontal"
                                                                            Spacing="0"
                                                                            Margin="8,6">
                                                                    <TextBlock Text="{Binding DisplayPrimary}"
                                                                               Classes="totem-picker-primary"
                                                                               Foreground="{Binding Brush}" />
                                                                    <TextBlock Text="{Binding DisplaySuffix}"
                                                                               Classes="totem-picker-suffix" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Panel>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Width="168"
                                            Spacing="6"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="Secondary Weather"
                                               Width="168"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="NoWrap"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondary}" />
                                    <Panel Width="168">
                                        <Border x:Name="SecondaryTotemPicker"
                                                Classes="totem-picker"
                                                Height="30"
                                                HorizontalAlignment="Stretch">
                                            <Grid ColumnDefinitions="*,34">
                                                <Border x:Name="SecondaryTotemField"
                                                        Grid.Column="0"
                                                        Background="Transparent"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        Margin="0,0,-1,0">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="0"
                                                                Margin="12,0,0,0"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AutoTotem.SelectedSecondaryTotem.DisplayPrimary}"
                                                                   Classes="totem-picker-primary"
                                                                   Foreground="{Binding AutoTotem.SelectedSecondaryTotem.Brush}" />
                                                        <TextBlock Text="{Binding AutoTotem.SelectedSecondaryTotem.DisplaySuffix}"
                                                                   Classes="totem-picker-suffix" />
                                                    </StackPanel>
                                                </Border>
                                                <Button Grid.Column="1"
                                                        x:Name="SecondaryTotemDropdownButton"
                                                        Classes="totem-picker-button"
                                                        Click="SecondaryTotemDropdownButton_OnClick">
                                                    <Path Width="10"
                                                          Height="6"
                                                          Stretch="Fill"
                                                          Fill="{StaticResource AccentForeground}"
                                                          Data="M 0 0 L 5 6 L 10 0 Z" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <Popup x:Name="SecondaryTotemDropdownPopup"
                                               PlacementTarget="{Binding #SecondaryTotemPicker}"
                                               Placement="AnchorAndGravity"
                                               PlacementAnchor="BottomLeft"
                                               PlacementGravity="BottomRight"
                                               IsLightDismissEnabled="True">
                                            <Border x:Name="SecondaryTotemDropdownBorder"
                                                    Classes="totem-dropdown-surface"
                                                    Width="{Binding #SecondaryTotemPicker.Bounds.Width, Converter={StaticResource ScaledPopupWidthConverter}}"
                                                    Margin="0,4,0,0">
                                                <ScrollViewer MaxHeight="220"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <ListBox Classes="totem-dropdown"
                                                             ItemsSource="{Binding AutoTotem.SecondaryTotemOptions}"
                                                             SelectedItem="{Binding AutoTotem.SelectedSecondaryTotem}"
                                                             SelectionChanged="SecondaryTotemList_OnSelectionChanged">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:TotemOptionViewModel">
                                                                <StackPanel Orientation="Horizontal"
                                                                            Spacing="0"
                                                                            Margin="8,6">
                                                                    <TextBlock Text="{Binding DisplayPrimary}"
                                                                               Classes="totem-picker-primary"
                                                                               Foreground="{Binding Brush}" />
                                                                    <TextBlock Text="{Binding DisplaySuffix}"
                                                                               Classes="totem-picker-suffix" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Panel>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="6"
                                    Height="1"
                                    Width="430"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource Border}"
                                    Opacity="0.45" />

                            <Grid Grid.Row="8"
                                  Width="430"
                                  ColumnDefinitions="1*,1,1*"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <StackPanel Grid.Column="0"
                                            Spacing="6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Cycle Lock"
                                               Width="176"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="NoWrap"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondary}" />
                                    <Grid Width="176"
                                          ColumnDefinitions="*,Auto,16,Auto,*"
                                          HorizontalAlignment="Center">
                                        <CheckBox Grid.Column="1"
                                                  Classes="auto-totem-option"
                                                  HorizontalAlignment="Center"
                                                  Content="Stay Day"
                                                  IsEnabled="{Binding AutoTotem.IsTimePreferenceEditable}"
                                                  IsChecked="{Binding AutoTotem.StayDay}"
                                                  FontSize="10" />
                                        <CheckBox Grid.Column="3"
                                                  Classes="auto-totem-option"
                                                  HorizontalAlignment="Center"
                                                  Content="Stay Night"
                                                  IsEnabled="{Binding AutoTotem.IsTimePreferenceEditable}"
                                                  IsChecked="{Binding AutoTotem.StayNight}"
                                                  FontSize="10" />
                                    </Grid>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Width="1"
                                        Height="38"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource Border}"
                                        Opacity="0.35" />

                                <StackPanel Grid.Column="2"
                                              Width="170"
                                              Spacing="6"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                      <TextBlock Text="Shiny / Sparkling / Mutation"
                                                 Width="170"
                                                 Margin="18,0,0,0"
                                                 HorizontalAlignment="Center"
                                                 TextAlignment="Center"
                                                 TextWrapping="NoWrap"
                                                 FontSize="9"
                                                 Foreground="{StaticResource TextSecondary}" />
                                      <Grid Width="170"
                                            ColumnDefinitions="Auto,12,Auto,12,Auto"
                                            HorizontalAlignment="Center">
                                          <CheckBox Grid.Column="0"
                                                      Classes="auto-totem-option"
                                                      HorizontalAlignment="Center"
                                                      Content="Shiny"
                                                      IsChecked="{Binding AutoTotem.UseShinyTotem}"
                                                      FontSize="10" />
                                          <CheckBox Grid.Column="2"
                                                      Classes="auto-totem-option"
                                                      HorizontalAlignment="Center"
                                                      Content="Sparkling"
                                                      IsChecked="{Binding AutoTotem.UseSparklingTotem}"
                                                      FontSize="10" />
                                          <CheckBox Grid.Column="4"
                                                      Classes="auto-totem-option"
                                                      HorizontalAlignment="Center"
                                                      Content="Mutation"
                                                    IsChecked="{Binding AutoTotem.UseMutationTotem}"
                                                    FontSize="10" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                        </Grid>
                    </Border>

                    <Grid Grid.Row="2"
                          Width="560"
                          ColumnDefinitions="*,8,*"
                          HorizontalAlignment="Center">
                        <Border Grid.Column="0"
                            Classes="app-header"
                            Padding="12,10"
                            Width="276"
                            MinHeight="96">
                            <Grid RowDefinitions="20,6,Auto"
                                  Width="180"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <CheckBox Grid.Row="0"
                                          Classes="addon-power-toggle"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="Auto Aquarium"
                                          IsChecked="{Binding AutoAquariumEnabled}"
                                          FontFamily="{StaticResource DisplayFont}"
                                          FontSize="13" />
                                <StackPanel Grid.Row="2"
                                            Spacing="2"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="Cycle delay"
                                               HorizontalAlignment="Center"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondary}" />
                                    <TextBox Classes="app-input"
                                             Width="72"
                                             Height="28"
                                             HorizontalAlignment="Center"
                                             HorizontalContentAlignment="Center"
                                             Text="{Binding AutoAquariumCycleDelayMinutes}"
                                             PlaceholderText="Min" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                            Classes="app-header"
                            Padding="12,10"
                            Width="276"
                            MinHeight="96">
                            <Grid RowDefinitions="20,6,Auto"
                                  Width="180"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <CheckBox Grid.Row="0"
                                          Classes="addon-power-toggle"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="Sov Recharge"
                                          IsChecked="{Binding AutoSovereignRechargeEnabled}"
                                          FontFamily="{StaticResource DisplayFont}"
                                          FontSize="13" />
                                <Grid Grid.Row="2"
                                      Width="180"
                                      ColumnDefinitions="*,8,*"
                                      HorizontalAlignment="Center">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Min %" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                        <TextBox Classes="app-input"
                                                 Width="86"
                                                 Height="28"
                                                 MaxLength="3"
                                                 HorizontalContentAlignment="Center"
                                                 Text="{Binding AutoSovereignRecharge.MinimumPercentText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Text="Max %" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                        <TextBox Classes="app-input"
                                                 Width="86"
                                                 Height="28"
                                                 MaxLength="3"
                                                 HorizontalContentAlignment="Center"
                                                 Text="{Binding AutoSovereignRecharge.MaximumPercentText}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
