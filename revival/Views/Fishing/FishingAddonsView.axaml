<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Client.ViewModels"
             x:Class="Client.Views.FishingAddonsView"
             x:DataType="vm:FishingAddonsViewModel"
             Background="{StaticResource Background}">
    <ScrollViewer Margin="0"
                  VerticalContentAlignment="Center"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8"
                    Margin="22,0,22,18"
                    VerticalAlignment="Center">
            <StackPanel Spacing="6"
                        Margin="0">
                <TextBlock Text="Fishing Setup"
                           Classes="tab-section-title"
                           Margin="0" />

                <Border Classes="app-header"
                        Padding="14,8">
                    <Grid ColumnDefinitions="*,Auto,72,8,68,40,Auto,8,80,*"
                          VerticalAlignment="Center">
                        <TextBlock Grid.Column="1"
                                   Text="Hotkey"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding General.HotkeyText}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextPrimary}" />
                        <Button Grid.Column="4"
                                Classes="app-secondary"
                                Height="30"
                                Padding="6,0"
                                FontSize="10"
                                Content="{Binding General.RebindButtonText}"
                                Command="{Binding General.RebindHotkeyCommand}" />

                        <TextBlock Grid.Column="6"
                                   Text="Rod Slot"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondary}" />
                        <ComboBox Grid.Column="8"
                                  Classes="app-select"
                                  Height="30"
                                  ItemsSource="{Binding General.RodSlots}"
                                  SelectedItem="{Binding General.SelectedRodSlot}" />
                    </Grid>
                </Border>

                <TextBlock Text="Automation Settings"
                           Classes="tab-section-title"
                           Margin="0,4,0,0" />

                <Grid ColumnDefinitions="2*,10,*"
                      RowDefinitions="*,10,*"
                      Height="250">
                    <Border Grid.Column="0"
                            Grid.RowSpan="3"
                            Classes="app-header"
                            Padding="10,7">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Auto Totem"
                                       HorizontalAlignment="Center"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <Grid ColumnDefinitions="*,12,*">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Weather" HorizontalAlignment="Center" TextAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                    <ComboBox Classes="app-select" Width="150" Height="30"
                                              HorizontalAlignment="Center"
                                              HorizontalContentAlignment="Center"
                                              ItemsSource="{Binding AutoTotem.PrimaryTotemOptions}"
                                              SelectedItem="{Binding AutoTotem.SelectedTotem}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Secondary Weather" HorizontalAlignment="Center" TextAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                    <ComboBox Classes="app-select" Width="150" Height="30"
                                              HorizontalAlignment="Center"
                                              HorizontalContentAlignment="Center"
                                              ItemsSource="{Binding AutoTotem.SecondaryTotemOptions}"
                                              SelectedItem="{Binding AutoTotem.SelectedSecondaryTotem}" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1"
                                    Background="{StaticResource Border}"
                                    Opacity="0.45" />

                            <StackPanel Spacing="3">
                                <TextBlock Text="Shiny / Sparkling / Mutation" HorizontalAlignment="Center" TextAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                <Grid ColumnDefinitions="*,8,*,8,*">
                                    <CheckBox Grid.Column="0" HorizontalAlignment="Center" Content="Shiny" IsChecked="{Binding AutoTotem.UseShinyTotem}" FontSize="11" />
                                    <CheckBox Grid.Column="2" HorizontalAlignment="Center" Content="Sparkling" IsChecked="{Binding AutoTotem.UseSparklingTotem}" FontSize="11" />
                                    <CheckBox Grid.Column="4" HorizontalAlignment="Center" Content="Mutation" IsChecked="{Binding AutoTotem.UseMutationTotem}" FontSize="11" />
                                </Grid>
                            </StackPanel>

                            <Border Height="1"
                                    Background="{StaticResource Border}"
                                    Opacity="0.45" />

                            <StackPanel Spacing="3">
                                <TextBlock Text="Cycle Lock" HorizontalAlignment="Center" TextAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                <Grid ColumnDefinitions="*,8,*">
                                    <CheckBox Grid.Column="0" HorizontalAlignment="Center" Content="Stay Day"
                                              IsEnabled="{Binding AutoTotem.IsTimePreferenceEditable}"
                                              IsChecked="{Binding AutoTotem.StayDay}" FontSize="11" />
                                    <CheckBox Grid.Column="2" HorizontalAlignment="Center" Content="Stay Night"
                                              IsEnabled="{Binding AutoTotem.IsTimePreferenceEditable}"
                                              IsChecked="{Binding AutoTotem.StayNight}" FontSize="11" />
                                </Grid>
                            </StackPanel>
                            <Border Height="1"
                                    Background="{StaticResource Border}"
                                    Opacity="0.45" />
                            <CheckBox HorizontalAlignment="Center"
                                      Margin="0,1,0,0"
                                      Content="On"
                                      IsChecked="{Binding AutoTotemEnabled}"
                                      FontSize="12" />

                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Grid.Row="2"
                            Classes="app-header"
                            Padding="10,7">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Sov Recharge"
                                       HorizontalAlignment="Center"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <Grid ColumnDefinitions="*,8,*">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Min %" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                    <TextBox Classes="app-input" Height="30" MaxLength="3"
                                             HorizontalContentAlignment="Center"
                                             Text="{Binding AutoSovereignRecharge.MinimumPercentText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Max %" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                    <TextBox Classes="app-input" Height="30" MaxLength="3"
                                             HorizontalContentAlignment="Center"
                                             Text="{Binding AutoSovereignRecharge.MaximumPercentText}" />
                                </StackPanel>
                            </Grid>
                            <CheckBox HorizontalAlignment="Center" Content="On"
                                      IsChecked="{Binding AutoSovereignRechargeEnabled}" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Grid.Row="0"
                            Classes="app-header"
                            Padding="10,7">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Auto Aquarium"
                                       HorizontalAlignment="Center"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="Cycle delay" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                <TextBox Classes="app-input" Width="72" Height="30" MaxLength="3"
                                         HorizontalAlignment="Center"
                                         HorizontalContentAlignment="Center"
                                         Text="{Binding AutoAquariumCycleDelayMinutes}"
                                         PlaceholderText="Min" />
                            </StackPanel>
                            <CheckBox HorizontalAlignment="Center" Content="On"
                                      IsChecked="{Binding AutoAquariumEnabled}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
