<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Client.ViewModels"
             x:Class="Client.Views.AppraiseAutomationView"
             x:DataType="vm:AppraiseAutomationViewModel"
             Background="{StaticResource Background}">
    <ScrollViewer Margin="0"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="6">
            <TextBlock Text="Auto Appraise"
                       Margin="24,24,24,0"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" />

            <ContentControl Content="{Binding AppraiseAutomation}" />

            <TextBlock Text="Treasure Appraise"
                       Margin="34,2,34,0"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" />

            <ContentControl Content="{Binding TreasureAppraiseAutomation}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
