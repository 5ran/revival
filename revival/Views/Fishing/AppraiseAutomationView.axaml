<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Client.ViewModels"
             x:Class="Client.Views.AppraiseAutomationView"
             x:DataType="vm:AppraiseAutomationViewModel"
             Background="{StaticResource Background}">
    <ScrollViewer Margin="0"
                  VerticalContentAlignment="Center"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12"
                    Width="550"
                    Margin="0,8,0,8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <ContentControl Content="{Binding AppraiseAutomation}" />

            <ContentControl Content="{Binding TreasureAppraiseAutomation}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
