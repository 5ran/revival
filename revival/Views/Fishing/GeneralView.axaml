<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Client.ViewModels"
             xmlns:controls="using:Client.Controls"
             x:Class="Client.Views.GeneralView"
             x:DataType="vm:GeneralViewModel"
             Background="Transparent">
    <UserControl.Styles>
        <Style Selector="Border.fishing-panel">
            <Setter Property="Background" Value="{StaticResource TableSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="Border.fishing-card">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="TextBlock.fishing-heading">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style Selector="TextBlock.fishing-copy">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>

        <Style Selector="Button.fishing-primary">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="{StaticResource AccentForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.fishing-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentHover}" />
        </Style>

        <Style Selector="Button.fishing-secondary">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.fishing-secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource InputHoverSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>

        <Style Selector="ComboBox.fishing-select">
            <Setter Property="Background" Value="{StaticResource TableSurface}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="ComboBox.fishing-select:pointerover">
            <Setter Property="Background" Value="{StaticResource InputHoverSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>

        <Style Selector="ComboBox.fishing-select:pointerover /template/ Border">
            <Setter Property="Background" Value="{StaticResource InputHoverSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>

        <Style Selector="TextBox.fishing-input">
            <Setter Property="Background" Value="{StaticResource TableSurface}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="ToggleButton.fish-skip-activate">
            <Setter Property="Background" Value="{StaticResource TableSurface}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="ToggleButton.fish-skip-activate /template/ ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="ToggleButton.fish-skip-activate:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ToggleHoverBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource ToggleHoverBorder}" />
        </Style>

        <Style Selector="ToggleButton.fish-skip-activate:checked">
            <Setter Property="Background" Value="{StaticResource ToggleCheckedBackground}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource ToggleCheckedBorder}" />
        </Style>

        <Style Selector="ToggleButton.fish-skip-activate:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ToggleCheckedBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource ToggleCheckedBorder}" />
        </Style>

        <Style Selector="ToggleButton.fish-skip-activate:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource InputHoverSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource ToggleCheckedBorder}" />
        </Style>

        <Style Selector="CheckBox.fish-skip-choice">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Name="ChoiceBox"
                                Width="15"
                                Height="15"
                                Background="{StaticResource TableSurface}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <Path Name="ChoiceMark"
                                  IsVisible="False"
                                  Width="7"
                                  Height="5"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stretch="Fill"
                                  Stroke="{StaticResource AccentForeground}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round"
                                  Data="M 0 2.5 L 2.5 5 L 7 0" />
                        </Border>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="CheckBox.fish-skip-choice:checked /template/ Border#ChoiceBox">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>

        <Style Selector="CheckBox.fish-skip-choice:checked /template/ Path#ChoiceMark">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="22,10"
          RowDefinitions="64,8,Auto,6,164,8,Auto,6,*">
        <Border Grid.Row="0"
                Classes="fishing-panel"
                Padding="12,8">
            <Grid ColumnDefinitions="120,*,120"
                  VerticalAlignment="Center">
                <Grid Grid.Column="2"
                      Width="40"
                      Height="40"
                      HorizontalAlignment="Right"
                      Margin="0,0,8,0">
                    <Ellipse Stroke="{StaticResource Accent}"
                             StrokeThickness="1.5"
                             Fill="Transparent" />
                    <Border Width="12"
                            Height="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{StaticResource Accent}"
                            CornerRadius="2" />
                </Grid>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <TextBlock Text="{Binding RunStateText}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8">
                        <TextBlock Text="{Binding Fishing.RodHeaderText}"
                                   Classes="fishing-copy"
                                   FontWeight="SemiBold" />
                        <controls:ColoredTextBlock Lines="{Binding Fishing.EquippedRodLines}"
                                                   IsVisible="{Binding Fishing.HasEquippedRodDisplay}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontFamily="{StaticResource UIFont}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="0"
                        Classes="fishing-primary"
                        Width="104"
                        Height="36"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{Binding StartStopButtonText}"
                        Command="{Binding ToggleMacroCommand}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="Controls"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   FontFamily="{StaticResource DisplayFont}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}" />

        <Border Grid.Row="4"
                Classes="fishing-card"
                Width="550"
                HorizontalAlignment="Center"
                Padding="20,0">
            <Grid RowDefinitions="40,1,82,1,40">
                <Grid Grid.Row="4" ColumnDefinitions="225,60,225">
                    <TextBlock Grid.Column="0" Text="Tracking Method" Classes="fishing-heading"
                               HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right" />
                    <ComboBox Grid.Column="2" Classes="fishing-select" Height="30" VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding Fishing.TrackerOptions}" SelectedItem="{Binding Fishing.SelectedTracker}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FishingTrackerOption">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.SelectionBoxItemTemplate>
                            <DataTemplate x:DataType="vm:FishingTrackerOption">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.SelectionBoxItemTemplate>
                    </ComboBox>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource Border}" />
                <Grid Grid.Row="0" ColumnDefinitions="225,60,225">
                    <TextBlock Grid.Column="0" Text="Casting" Classes="fishing-heading"
                               HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right" />
                    <ComboBox Grid.Column="2" Classes="fishing-select" Height="30" VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding Fishing.CastingModes}" SelectedItem="{Binding Fishing.SelectedCastingMode}" />
                </Grid>
                <Border Grid.Row="3" Background="{StaticResource Border}" />
                <Grid Grid.Row="2"
                      RowDefinitions="Auto,3,Auto"
                      Margin="16,6">
                    <StackPanel Grid.Row="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="3">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="10">
                            <TextBlock Text="Skip"
                                       Classes="fishing-heading"
                                       VerticalAlignment="Center" />
                            <ToggleButton Classes="fish-skip-activate"
                                          Width="66"
                                          Height="26"
                                          VerticalAlignment="Center"
                                          Content="{Binding Fishing.FishSkipToggleText}"
                                          IsChecked="{Binding Fishing.FishSkipEnabled}" />
                        </StackPanel>
                        <TextBlock Text="Select the fish you want to skip"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                    <UniformGrid Grid.Row="2"
                          Columns="4"
                          Margin="0,-2,0,0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center">
                        <CheckBox Classes="fish-skip-choice" Content="common"
                                  IsEnabled="{Binding Fishing.FishSkipEnabled}"
                                  IsHitTestVisible="{Binding Fishing.FishSkipEnabled}"
                                  IsChecked="{Binding Fishing.FishSkipCommonSelected}" />
                        <CheckBox Classes="fish-skip-choice" Content="legendary / mythic"
                                  IsEnabled="{Binding Fishing.FishSkipEnabled}"
                                  IsHitTestVisible="{Binding Fishing.FishSkipEnabled}"
                                  IsChecked="{Binding Fishing.FishSkipLegendaryMythicSelected}" />
                        <CheckBox Classes="fish-skip-choice" Content="exotic / secret"
                                  IsEnabled="{Binding Fishing.FishSkipEnabled}"
                                  IsHitTestVisible="{Binding Fishing.FishSkipEnabled}"
                                  IsChecked="{Binding Fishing.FishSkipExoticSecretSelected}" />
                        <CheckBox Classes="fish-skip-choice" Content="special"
                                  IsEnabled="{Binding Fishing.FishSkipEnabled}"
                                  IsHitTestVisible="{Binding Fishing.FishSkipEnabled}"
                                  IsChecked="{Binding Fishing.FishSkipSpecialSelected}" />
                    </UniformGrid>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="6"
                   Text="Shortcuts"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   FontFamily="{StaticResource DisplayFont}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}" />

        <Grid Grid.Row="8"
              ColumnDefinitions="*,10,*,10,*">
            <Border Grid.Column="0" Classes="fishing-card" Padding="8">
                <Grid RowDefinitions="26,Auto,*,Auto">
                    <Viewbox Grid.Row="0" Width="22" Height="22" HorizontalAlignment="Center">
                        <Canvas Width="18" Height="18">
                            <Path Data="M 6 1.5 L 12 1.5 L 13 5 L 13 6.5 L 16 7.5 L 14 10 L 12 10 L 12 16.5 L 6 16.5 L 6 10 L 4 10 L 2 7.5 L 5 6.5 L 5 5 Z M 7.5 3.5 L 7.5 5.5 M 10.5 3.5 L 10.5 5.5 M 7 8 L 10.5 8 L 8 10.5 L 11 10.5"
                                  Stroke="{StaticResource Accent}" StrokeThickness="1.4" StrokeLineCap="Round" Fill="Transparent" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Row="1" Text="Auto Totem" Classes="fishing-heading" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Grid.Row="2" Text="Enable automatic totem use" Classes="fishing-copy"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <CheckBox Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsChecked="{Binding FishingAddons.AutoTotemEnabled}" />
                </Grid>
            </Border>

            <Border Grid.Column="4" Classes="fishing-card" Padding="8">
                <Grid RowDefinitions="26,Auto,*,Auto">
                    <Viewbox Grid.Row="0" Width="26" Height="26" Margin="0,-2,0,0" HorizontalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M 9 2.5 L 15 2.5 M 10 5 L 14 5 M 10 5 C 8 7 5.5 8.5 5 13.5 L 4.5 19.5 Q 12 22 19.5 19.5 L 19 13.5 C 18.5 8.5 16 7 14 5 M 5.2 12.8 C 7.3 11.7 9.6 13.7 12 12.8 C 14.4 11.9 16.7 13.5 18.8 12.8"
                                  Stroke="{StaticResource Accent}" StrokeThickness="1.7" StrokeLineCap="Round" Fill="Transparent" />
                            <Path Data="M 8.8 17.2 C 10 16.1 12.1 16.1 13.4 17.2 C 12.1 18.3 10 18.3 8.8 17.2 Z M 13.4 17.2 L 15.1 16.3 L 15.1 18.1 Z"
                                  Stroke="{StaticResource Accent}" StrokeThickness="1.7" StrokeLineCap="Round" Fill="Transparent" />
                            <Ellipse Width="1.2"
                                     Height="1.2"
                                     Canvas.Left="9.75"
                                     Canvas.Top="16.6"
                                     Fill="{StaticResource Accent}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Row="1" Text="Auto Aquarium" Classes="fishing-heading" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Grid.Row="2" Text="Feed aquarium while macroing" Classes="fishing-copy"
                               Height="18"
                               LineHeight="14"
                               Padding="0,0,0,3"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" />
                    <CheckBox Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsChecked="{Binding FishingAddons.AutoAquariumEnabled}" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Classes="fishing-card" Padding="8">
                <Grid RowDefinitions="26,Auto,*,Auto">
                    <Viewbox Grid.Row="0" Width="22" Height="22" HorizontalAlignment="Center">
                        <Canvas Width="18" Height="18">
                            <Path Data="M 9 1 L 11.2 5.2 L 14.6 2.8 L 13.2 7.2 L 17 8.4 L 13.3 10.6 L 15.5 15.6 L 10.8 13.1 L 9 17 L 7.2 13.1 L 2.5 15.6 L 4.7 10.6 L 1 8.4 L 4.8 7.2 L 3.4 2.8 L 6.8 5.2 Z M 9 4.6 L 11.8 8.8 L 9 13.4 L 6.2 8.8 Z M 4.8 7.2 L 6.2 8.8 M 13.2 7.2 L 11.8 8.8 M 4.7 10.6 L 7.2 13.1 M 13.3 10.6 L 10.8 13.1"
                                  Stroke="{StaticResource Accent}" StrokeThickness="1.4" StrokeLineCap="Round" Fill="Transparent" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Row="1" Text="Sov Recharge" Classes="fishing-heading" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Grid.Row="2" Text="Recharge between catches" Classes="fishing-copy"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <CheckBox Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsChecked="{Binding FishingAddons.AutoSovereignRechargeEnabled}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
