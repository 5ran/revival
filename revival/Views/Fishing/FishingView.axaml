<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Client.ViewModels"
             xmlns:controls="using:Client.Controls"
             x:Class="Client.Views.FishingView"
             x:DataType="vm:FishingViewModel"
             Background="{StaticResource Background}">
    <UserControl.Styles>
        <Style Selector="Button.fish-primary">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.fish-primary /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.fish-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentHover}"/>
        </Style>
        <Style Selector="Button.fish-primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentPressed}"/>
        </Style>
        <Style Selector="Button.fish-secondary">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ButtonSecondaryForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ButtonSecondaryBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.fish-secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryHoverBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ButtonSecondaryHoverBorder}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource ButtonSecondaryForeground}"/>
        </Style>
        <Style Selector="Button.fish-secondary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryPressedBackground}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource ButtonSecondaryForeground}"/>
        </Style>
        <Style Selector="ComboBox.fish-select">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="ComboBox.fish-select:pointerover">
            <Setter Property="Background" Value="{StaticResource InputHoverSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputHoverBorder}"/>
        </Style>
        <Style Selector="ComboBox.fish-select:pointerover /template/ Border">
            <Setter Property="Background" Value="{StaticResource InputHoverSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputHoverBorder}"/>
        </Style>
        <Style Selector="Border.fish-picker">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="Button.fish-picker-button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="CornerRadius" Value="0,6,6,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.fish-picker-button:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentHover}"/>
        </Style>
        <Style Selector="Button.fish-picker-button:pressed">
            <Setter Property="Background" Value="{StaticResource AccentPressed}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentPressed}"/>
        </Style>
        <Style Selector="Border.fish-dropdown-surface">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style Selector="ListBox.fish-dropdown">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox.fish-dropdown ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.fish-dropdown ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="ListBox.fish-dropdown ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource InputHoverSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Style>
        <Style Selector="ListBox.fish-dropdown ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ToggleCheckedBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ToggleCheckedBorder}"/>
        </Style>
        <Style Selector="TextBox.fish-input">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.fish-nav">
            <Setter Property="Background" Value="{StaticResource TableSurface}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="NavRoot"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Path.fish-nav-arrow">
            <Setter Property="Stroke" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Stroke" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.fish-nav:pointerover Path.fish-nav-arrow">
            <Setter Property="Stroke" Value="{StaticResource TextPrimary}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*"
          Margin="22,10">
        <Border Grid.Row="0"
                Classes="app-card"
                Width="550"
                HorizontalAlignment="Center"
                Padding="20,14">
            <Grid Grid.Column="0"
                  RowDefinitions="Auto,12,Auto"
                  ColumnDefinitions="*,24,220">
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Tracking Method"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource UIFont}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" />
                <Panel Grid.Row="0"
                       Grid.Column="2"
                       HorizontalAlignment="Stretch">
                    <Border x:Name="TrackerPicker"
                            Classes="fish-picker"
                            Height="38"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="*,56">
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Margin="12,0,8,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedTracker.Title}"
                                           FontFamily="{StaticResource UIFont}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="{Binding SelectedTracker.Description}"
                                           FontFamily="{StaticResource UIFont}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="{Binding SelectedTracker.DescriptionMargin}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="fish-picker-button"
                                    Click="TrackerDropdownButton_OnClick">
                                <Path Width="10"
                                      Height="6"
                                      Stretch="Fill"
                                      Fill="{StaticResource AccentForeground}"
                                      Data="M 0 0 L 5 6 L 10 0 Z" />
                            </Button>
                        </Grid>
                    </Border>
                    <Popup x:Name="TrackerDropdownPopup"
                           PlacementTarget="{Binding #TrackerPicker}"
                           Placement="AnchorAndGravity"
                           PlacementAnchor="BottomLeft"
                           PlacementGravity="BottomRight"
                           IsLightDismissEnabled="True">
                        <Border Classes="fish-dropdown-surface"
                                Width="{Binding #TrackerPicker.Bounds.Width, Converter={StaticResource ScaledPopupWidthConverter}}"
                                Margin="0,4,0,0">
                            <ListBox Classes="fish-dropdown"
                                     ItemsSource="{Binding TrackerOptions}"
                                     SelectedItem="{Binding SelectedTracker}"
                                     SelectionChanged="TrackerList_OnSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FishingTrackerOption">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="6"
                                                    Margin="8,6">
                                            <TextBlock Text="{Binding Title}"
                                                       FontFamily="{StaticResource UIFont}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="{Binding Description}"
                                                       FontFamily="{StaticResource UIFont}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       Margin="{Binding DescriptionMargin}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Panel>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Casting"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource UIFont}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" />
                <Panel Grid.Row="2"
                       Grid.Column="2"
                       HorizontalAlignment="Stretch">
                    <Border x:Name="CastingPicker"
                            Classes="fish-picker"
                            Height="38"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="*,56">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding SelectedCastingMode}"
                                       Margin="12,0,8,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource UIFont}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextPrimary}" />
                            <Button Grid.Column="1"
                                    Classes="fish-picker-button"
                                    Click="CastingDropdownButton_OnClick">
                                <Path Width="10"
                                      Height="6"
                                      Stretch="Fill"
                                      Fill="{StaticResource AccentForeground}"
                                      Data="M 0 0 L 5 6 L 10 0 Z" />
                            </Button>
                        </Grid>
                    </Border>
                    <Popup x:Name="CastingDropdownPopup"
                           PlacementTarget="{Binding #CastingPicker}"
                           Placement="AnchorAndGravity"
                           PlacementAnchor="BottomLeft"
                           PlacementGravity="BottomRight"
                           IsLightDismissEnabled="True">
                        <Border Classes="fish-dropdown-surface"
                                Width="{Binding #CastingPicker.Bounds.Width, Converter={StaticResource ScaledPopupWidthConverter}}"
                                Margin="0,4,0,0">
                            <ListBox Classes="fish-dropdown"
                                     ItemsSource="{Binding CastingModes}"
                                     SelectedItem="{Binding SelectedCastingMode}"
                                     SelectionChanged="CastingList_OnSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="{StaticResource UIFont}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   Margin="8,6" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Panel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Margin="0,10,0,0"
              ColumnDefinitions="*,12,*">
            <controls:AppKeyValueList Grid.Column="0"
                                      Items="{Binding StatusItems}" />
            <controls:AppKeyValueList Grid.Column="2"
                                      Items="{Binding StatsItems}" />
        </Grid>

        <Grid Grid.Row="2"
              IsVisible="{Binding IsMasterlineEquipped}"
              Margin="0,4,0,0"
              HorizontalAlignment="Stretch"
              ColumnDefinitions="Auto,12,*">
            <TextBlock Grid.Column="0"
                       Text="Masterline Rods"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource UIFont}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}" />
            <TextBlock Grid.Column="2"
                       Text="{Binding MasterlineRodNamesText}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       FontFamily="{StaticResource UIFont}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" />
        </Grid>
    </Grid>
</UserControl>
