<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Client.ViewModels"
             x:Class="Client.Views.OtherAutomationView"
             x:DataType="vm:OtherAutomationViewModel"
             Background="{StaticResource Background}">
    <Grid>
        <ScrollViewer Margin="0"
                      VerticalContentAlignment="Center"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Width="550"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ContentControl Content="{Binding EnchantAutomation}" />
            </StackPanel>
        </ScrollViewer>
        <Button Classes="app-secondary"
                Width="34"
                Height="30"
                Margin="8,8,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                FontSize="16"
                Padding="0"
                Content="←"
                Command="{Binding NavigateBackToSystemsCommand}" />
    </Grid>
</UserControl>
