<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Client.ViewModels"
             x:Class="Client.Views.AutoAnglerView"
             x:DataType="vm:AutoAnglerViewModel"
             Background="{StaticResource Background}">
    <Border Classes="app-card"
            Width="550"
            HorizontalAlignment="Center"
            Padding="0">
        <Grid RowDefinitions="64,1,84">
            <Grid Grid.Row="0"
                  ColumnDefinitions="145,12,1,12,170,12,1,12,145"
                  HorizontalAlignment="Center"
                  Margin="14,10">
                <StackPanel Grid.Column="0"
                            Spacing="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Current Fish"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding CurrentFishText}"
                               Width="120"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />
                </StackPanel>

                <Border Grid.Column="2"
                        Background="{StaticResource Border}" />

                <CheckBox Grid.Column="4"
                          IsChecked="{Binding AutoAnglerEnabled}"
                          Content="Auto Angler"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          FontFamily="{StaticResource UIFont}"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextPrimary}" />

                <Border Grid.Column="6"
                        Background="{StaticResource Border}" />

                <StackPanel Grid.Column="8"
                            Spacing="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Status"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding StatusText}"
                               Width="120"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="{StaticResource Border}" />

            <Grid Grid.Row="2"
                  ColumnDefinitions="Auto,12,Auto,18,Auto"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <StackPanel Grid.Column="0"
                            Spacing="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Click X"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextSecondary}" />
                    <TextBox Classes="app-input"
                             Width="92"
                             Height="30"
                             HorizontalContentAlignment="Center"
                             Text="{Binding ClickXText}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Spacing="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Click Y"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextSecondary}" />
                    <TextBox Classes="app-input"
                             Width="92"
                             Height="30"
                             HorizontalContentAlignment="Center"
                             Text="{Binding ClickYText}" />
                </StackPanel>

                <Button Grid.Column="4"
                        Classes="app-secondary"
                        Width="132"
                        Height="30"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Use Cursor"
                        Command="{Binding UseCursorPositionCommand}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
