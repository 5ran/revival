<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Client.ViewModels"
             x:Class="Client.Views.AutoAnglerView"
             x:DataType="vm:AutoAnglerViewModel"
             Background="{StaticResource Background}">
    <Border Classes="app-card"
            Width="550"
            HorizontalAlignment="Center"
            Padding="0">
        <Grid RowDefinitions="84,1,100">
            <Grid Grid.Row="0"
                  ColumnDefinitions="145,12,1,12,170,12,1,12,145"
                  HorizontalAlignment="Center"
                  Margin="14,10">
                <StackPanel Grid.Column="0"
                            Spacing="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Current Fish"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding CurrentFishText}"
                               Width="120"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />
                </StackPanel>

                <Border Grid.Column="2"
                        Background="{StaticResource Border}" />

                <CheckBox Grid.Column="4"
                          IsChecked="{Binding AutoAnglerEnabled}"
                          Content="Auto Angler"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          FontFamily="{StaticResource UIFont}"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextPrimary}" />

                <Border Grid.Column="6"
                        Background="{StaticResource Border}" />

                <StackPanel Grid.Column="8"
                            Spacing="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Status"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding StatusPrimaryText}"
                               Width="120"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="{Binding StatusDetailText}"
                               Width="120"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               IsVisible="{Binding HasStatusDetailText}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="{StaticResource Border}" />

            <Grid Grid.Row="2"
                  ColumnDefinitions="Auto"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <StackPanel Grid.Column="0"
                            Spacing="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Apply the clickpoint to the first voiceline in angler"
                               Width="320"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text='1. [&quot;What&apos;s the job?&quot;]'
                               Width="320"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextSecondary}" />
                    <Button Classes="app-secondary"
                            Width="156"
                            Height="30"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="Cursor Click Point"
                            Command="{Binding UseCursorPositionCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
