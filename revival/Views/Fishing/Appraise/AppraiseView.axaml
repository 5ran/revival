<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Client.ViewModels"
             xmlns:controls="using:Client.Controls"
             x:Class="Client.Views.AppraiseView"
             x:DataType="vm:AppraiseViewModel"
             Background="{StaticResource Background}">
    <UserControl.Styles>
        <Style Selector="TextBox.appraise-input">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="ToggleButton.appraise-select">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ToggleButton.appraise-select:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style Selector="ToggleButton.appraise-select:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>

        <Style Selector="ToggleButton.appraise-mutation">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.appraise-mutation /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ToggleButton.appraise-mutation:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryPressedBackground}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.appraise-mutation:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryHoverBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        </Style>
        <Style Selector="ToggleButton.appraise-mutation:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryHoverBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        </Style>

        <Style Selector="Button.appraise-add">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.appraise-add /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.appraise-add:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentHover}"/>
        </Style>
        <Style Selector="Button.appraise-add:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentPressed}"/>
        </Style>
        
        <Style Selector="Button.appraise-secondary">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ButtonSecondaryForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ButtonSecondaryBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.appraise-secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryHoverBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ButtonSecondaryHoverBorder}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource ButtonSecondaryForeground}"/>
        </Style>
        <Style Selector="Button.appraise-secondary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryPressedBackground}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource ButtonSecondaryForeground}"/>
        </Style>

        <Style Selector="Border.appraise-segmented">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style Selector="RadioButton.appraise-mode">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.appraise-mode:pointerover">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryHoverBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style Selector="RadioButton.appraise-mode:checked">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentForeground}"/>
        </Style>
        <Style Selector="RadioButton.appraise-mode:checked:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentHover}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentForeground}"/>
        </Style>
        <Style Selector="CheckBox.appraise-trait">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.appraise-picker">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="TextBox.appraise-picker-search">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6,0,0,6" />
        </Style>
        <Style Selector="ToggleButton.appraise-picker-summary">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="CornerRadius" Value="0,6,6,0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.appraise-picker-summary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryHoverBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        </Style>
        <Style Selector="ToggleButton.appraise-picker-summary:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryHoverBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,8,Auto">
        <Border Grid.Row="0"
                Classes="app-card"
                Padding="14,10">
            <Grid ColumnDefinitions="132,1,*,1,170"
                  ColumnSpacing="12">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding AutoAppraiseEnabled}"
                          Content="Auto Appraise"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          FontFamily="{StaticResource UIFont}"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextPrimary}" />

                <Border Grid.Column="1"
                        Background="{StaticResource Border}" />

                <StackPanel Grid.Column="2"
                            Spacing="6">
                    <TextBlock Text="Roll Method"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondary}" />
                    <Border Classes="appraise-segmented">
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="2">
                            <RadioButton Grid.Column="0"
                                         Classes="appraise-mode"
                                         GroupName="AppraiseRollMode"
                                         Content="Gamepass"
                                         IsChecked="{Binding IsGamepassMode}" />
                            <RadioButton Grid.Column="1"
                                         Classes="appraise-mode"
                                         GroupName="AppraiseRollMode"
                                         Content="Normal"
                                         IsChecked="{Binding IsNormalMode}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Grid.Column="3"
                        Background="{StaticResource Border}" />

                <Grid Grid.Column="4"
                      Height="50"
                      VerticalAlignment="Center">
                    <StackPanel IsVisible="{Binding IsGamepassMode}"
                                Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="Roll Speed"
                                       FontFamily="{StaticResource UIFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding GamepassSpeedPercentText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextPrimary}" />
                        </Grid>
                        <Slider Minimum="0"
                                Maximum="1"
                                Value="{Binding GamepassSpeed}"
                                TickFrequency="0.05" />
                    </StackPanel>

                    <Button Classes="appraise-secondary"
                            Height="34"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Content="Set Click Position"
                            IsVisible="{Binding IsNormalMode}"
                            Command="{Binding UseCursorPositionCommand}" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,10,*"
              RowDefinitions="Auto,8,66">
            <Border Grid.Column="0"
                    Grid.RowSpan="3"
                    Classes="app-card"
                    Padding="14,10">
                <StackPanel Spacing="8">
                    <TextBlock Text="Mutation"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />

                    <TextBlock Text="{Binding SelectedMutationsSummary}"
                               MinHeight="16"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondary}" />

                    <Panel>
                        <Border x:Name="MutationPicker"
                                Classes="appraise-picker"
                                Width="217"
                                HorizontalAlignment="Left">
                            <Grid ColumnDefinitions="*,64">
                                <TextBox x:Name="MutationSearchBox"
                                         Grid.Column="0"
                                         Classes="appraise-input appraise-picker-search"
                                         PlaceholderText="Search"
                                         Text="{Binding MutationSearchText}"
                                         PointerPressed="MutationSearchBox_OnPointerPressed"
                                         GotFocus="MutationSearchBox_OnGotFocus"
                                         TextChanged="MutationSearchBox_OnTextChanged" />
                                <Button Grid.Column="1"
                                        Classes="appraise-add"
                                        Margin="0"
                                        CornerRadius="0,5,5,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Click="MutationDropdownButton_OnClick">
                                    <Path Width="10"
                                          Height="6"
                                          Stretch="Fill"
                                          Fill="{StaticResource AccentForeground}"
                                          Data="M 0 0 L 5 6 L 10 0 Z" />
                                </Button>
                            </Grid>
                        </Border>

                        <Popup x:Name="MutationDropdownPopup"
                               PlacementTarget="{Binding #MutationPicker}"
                               Placement="BottomEdgeAlignedLeft"
                               IsLightDismissEnabled="True">
                            <Border Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="4"
                                    Width="260"
                                    Margin="0,4,0,0">
                                <ScrollViewer MaxHeight="220"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Mutations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AppraiseMutationOptionViewModel">
                                                <ToggleButton Classes="appraise-mutation"
                                                              IsChecked="{Binding IsSelected}">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Name}"
                                                                   Foreground="{Binding Brush}"
                                                                   FontFamily="{StaticResource UIFont}"
                                                                   FontSize="13"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding MultiText}"
                                                                   Margin="10,0,0,0"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Right" />
                                                    </Grid>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Panel>

                    <Border Classes="appraise-picker"
                            Width="217"
                            Height="34"
                            HorizontalAlignment="Left">
                        <Grid ColumnDefinitions="*,64">
                            <TextBox Grid.Column="0"
                                     Classes="appraise-input appraise-picker-search"
                                     PlaceholderText="Custom mutation"
                                     Text="{Binding NewMutationText}" />
                            <Button Grid.Column="1"
                                    Classes="appraise-add"
                                    Margin="0"
                                    CornerRadius="0,5,5,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Content="Add"
                                    Command="{Binding AddMutationCommand}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Grid.Row="0"
                    Classes="app-card"
                    Padding="14,10">
                <StackPanel Spacing="9">
                    <TextBlock Text="Required Traits"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />
                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="4"
                          ColumnSpacing="8">
                        <CheckBox Grid.Row="0" Grid.Column="0" Classes="appraise-trait" IsChecked="{Binding RequireShiny}"><TextBlock Text="Shiny" Foreground="{Binding ShinyBrush}" /></CheckBox>
                        <CheckBox Grid.Row="0" Grid.Column="1" Classes="appraise-trait" IsChecked="{Binding RequireSparkling}"><TextBlock Text="Sparkling" Foreground="{Binding SparklingBrush}" /></CheckBox>
                        <CheckBox Grid.Row="1" Grid.Column="0" Classes="appraise-trait" IsChecked="{Binding RequireTiny}"><TextBlock Text="Tiny" Foreground="{Binding TinyBrush}" /></CheckBox>
                        <CheckBox Grid.Row="1" Grid.Column="1" Classes="appraise-trait" IsChecked="{Binding RequireSmall}"><TextBlock Text="Small" Foreground="{Binding SmallBrush}" /></CheckBox>
                        <CheckBox Grid.Row="2" Grid.Column="0" Classes="appraise-trait" IsChecked="{Binding RequireBig}"><TextBlock Text="Big" Foreground="{Binding BigBrush}" /></CheckBox>
                        <CheckBox Grid.Row="2" Grid.Column="1" Classes="appraise-trait" IsChecked="{Binding RequireGiant}"><TextBlock Text="Giant" Foreground="{Binding GiantBrush}" /></CheckBox>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Grid.Row="2"
                    Classes="app-card"
                    Padding="12,8">
                <Grid ColumnDefinitions="*,1,*">
                    <StackPanel Grid.Column="0"
                                Spacing="3"
                                Margin="0,0,12,0">
                        <TextBlock Text="Held Fish"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondary}" />
                        <controls:ColoredTextBlock Lines="{Binding HeldFishLines}"
                                                   TextWrapping="Wrap"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{StaticResource Border}"
                            Margin="0,2" />

                    <StackPanel Grid.Column="2"
                                Spacing="3"
                                Margin="12,0,0,0">
                        <TextBlock Text="Status"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondary}" />
                        <controls:ColoredTextBlock Lines="{Binding StatusLines}"
                                                   TextWrapping="Wrap"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
