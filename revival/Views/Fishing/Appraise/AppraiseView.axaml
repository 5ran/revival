<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Client.ViewModels"
             xmlns:controls="using:Client.Controls"
             x:Class="Client.Views.AppraiseView"
             x:DataType="vm:AppraiseViewModel"
             Background="{StaticResource Background}">
    <UserControl.Styles>
        <Style Selector="TextBox.appraise-input">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="ToggleButton.appraise-select">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ToggleButton.appraise-select:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style Selector="ToggleButton.appraise-select:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>

        <Style Selector="ToggleButton.appraise-mutation">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.appraise-mutation /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ToggleButton.appraise-mutation:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryPressedBackground}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.appraise-mutation:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryHoverBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        </Style>
        <Style Selector="ToggleButton.appraise-mutation:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryHoverBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        </Style>

        <Style Selector="Button.appraise-add">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.appraise-add /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.appraise-add:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentHover}"/>
        </Style>
        <Style Selector="Button.appraise-add:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentPressed}"/>
        </Style>
        
        <Style Selector="Button.appraise-secondary">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ButtonSecondaryForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ButtonSecondaryBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.appraise-secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryHoverBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ButtonSecondaryHoverBorder}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource ButtonSecondaryForeground}"/>
        </Style>
        <Style Selector="Button.appraise-secondary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryPressedBackground}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource ButtonSecondaryForeground}"/>
        </Style>

        <Style Selector="Border.appraise-segmented">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style Selector="RadioButton.appraise-mode">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.appraise-mode:pointerover">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryHoverBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style Selector="RadioButton.appraise-mode:checked">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentForeground}"/>
        </Style>
        <Style Selector="RadioButton.appraise-mode:checked:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentHover}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentForeground}"/>
        </Style>
        <Style Selector="CheckBox.appraise-trait">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.appraise-picker">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="TextBox.appraise-picker-search">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6,0,0,6" />
        </Style>
        <Style Selector="ToggleButton.appraise-picker-summary">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="CornerRadius" Value="0,6,6,0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.appraise-picker-summary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryHoverBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        </Style>
        <Style Selector="ToggleButton.appraise-picker-summary:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryHoverBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        </Style>
        <Style Selector="Slider.appraise-speed">
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Slider.appraise-speed /template/ Track#PART_Track">
            <Setter Property="Height" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Slider.appraise-speed /template/ Thumb">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
        </Style>
        <Style Selector="Slider.appraise-speed /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="{StaticResource AccentHover}" />
        </Style>
        <Style Selector="Slider.appraise-speed:pointerover /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Slider.appraise-speed /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryBorder}" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Slider.appraise-speed /template/ Thumb /template/ Ellipse">
            <Setter Property="Fill" Value="{StaticResource Accent}" />
            <Setter Property="Stroke" Value="{StaticResource AccentHover}" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <Border Classes="app-card"
                Width="550"
                BorderBrush="{StaticResource Accent}"
                HorizontalAlignment="Center"
                Padding="0">
            <Grid RowDefinitions="64,1,42,1,128,1,46">
                <Grid Grid.Row="0"
                      ColumnDefinitions="145,12,1,12,170,12,1,12,145"
                      HorizontalAlignment="Center"
                      Margin="14,10">
                <StackPanel Grid.Column="0"
                            Spacing="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Held Fish"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextSecondary}" />
                    <controls:ColoredTextBlock Lines="{Binding HeldFishLines}"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap"
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                </StackPanel>

                <Border Grid.Column="2"
                        Background="{StaticResource Border}" />

                <CheckBox Grid.Column="4"
                          IsChecked="{Binding AutoAppraiseEnabled}"
                          Content="Auto Appraise"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          FontFamily="{StaticResource UIFont}"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextPrimary}" />

                <Border Grid.Column="6"
                        Background="{StaticResource Border}" />

                <StackPanel Grid.Column="8"
                            Spacing="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock Text="Status"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondary}" />
                        <controls:ColoredTextBlock Lines="{Binding StatusLines}"
                                                   HorizontalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                </StackPanel>
            </Grid>

                <Border Grid.Row="1"
                        Background="{StaticResource Border}" />

                <Grid Grid.Row="2"
                      Margin="20,0">
                    <Border Classes="appraise-segmented"
                            Height="30"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Width="210">
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="2">
                            <RadioButton Grid.Column="0"
                                         Classes="appraise-mode"
                                         GroupName="AppraiseRollMode"
                                         Content="Gamepass"
                                         IsChecked="{Binding IsGamepassMode}" />
                            <RadioButton Grid.Column="1"
                                         Classes="appraise-mode"
                                         GroupName="AppraiseRollMode"
                                         Content="Normal"
                                         IsChecked="{Binding IsNormalMode}" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="3"
                        Background="{StaticResource Border}" />

                <Grid Grid.Row="4"
                      RowDefinitions="Auto,5,34,7,Auto"
                      Margin="20,8">
                    <StackPanel Grid.Row="0"
                                HorizontalAlignment="Center"
                                Spacing="2">
                        <TextBlock Text="Mutation"
                                   HorizontalAlignment="Center"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="{Binding SelectedMutationsSummary}"
                                   MaxWidth="300"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>

                    <Grid Grid.Row="2"
                          ColumnDefinitions="*,12,*">
                        <Panel Grid.Column="0">
                            <Border x:Name="MutationPicker"
                                    Classes="appraise-picker"
                                    Height="34"
                                    HorizontalAlignment="Stretch">
                                <Grid ColumnDefinitions="*,64">
                                    <TextBox x:Name="MutationSearchBox"
                                             Grid.Column="0"
                                             Classes="appraise-input appraise-picker-search"
                                             PlaceholderText="Search"
                                             Text="{Binding MutationSearchText}"
                                             PointerPressed="MutationSearchBox_OnPointerPressed"
                                             GotFocus="MutationSearchBox_OnGotFocus"
                                             TextChanged="MutationSearchBox_OnTextChanged" />
                                    <Button Grid.Column="1"
                                            Classes="appraise-add"
                                            Margin="0"
                                            CornerRadius="0,5,5,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Click="MutationDropdownButton_OnClick">
                                        <Path Width="10"
                                              Height="6"
                                              Stretch="Fill"
                                              Fill="{StaticResource AccentForeground}"
                                              Data="M 0 0 L 5 6 L 10 0 Z" />
                                    </Button>
                                </Grid>
                            </Border>

                            <Popup x:Name="MutationDropdownPopup"
                                   PlacementTarget="{Binding #MutationPicker}"
                                   Placement="BottomEdgeAlignedLeft"
                                   IsLightDismissEnabled="True">
                                <Border Background="{StaticResource Surface}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4"
                                        Width="{Binding #MutationPicker.Bounds.Width}"
                                        Margin="0,4,0,0">
                                    <ScrollViewer MaxHeight="220"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Mutations}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AppraiseMutationOptionViewModel">
                                                    <ToggleButton Classes="appraise-mutation"
                                                                  IsChecked="{Binding IsSelected}">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Name}"
                                                                       Foreground="{Binding Brush}"
                                                                       FontFamily="{StaticResource UIFont}"
                                                                       FontSize="13"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding MultiText}"
                                                                       Margin="10,0,0,0"
                                                                       Foreground="{StaticResource TextSecondary}"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="12"
                                                                       HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </ToggleButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Panel>

                        <Border Grid.Column="2"
                                Classes="appraise-picker"
                                Height="34"
                                HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="*,64">
                                <TextBox Grid.Column="0"
                                         Classes="appraise-input appraise-picker-search"
                                         PlaceholderText="Custom mutation"
                                         Text="{Binding NewMutationText}" />
                                <Button Grid.Column="1"
                                        Classes="appraise-add"
                                        Margin="0"
                                        CornerRadius="0,5,5,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Content="Add"
                                        Command="{Binding AddMutationCommand}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4"
                          ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*,Auto,*,Auto"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center">
                        <CheckBox Grid.Column="0" Classes="appraise-trait" IsChecked="{Binding RequireShiny}"><TextBlock Text="Shiny" Foreground="{Binding ShinyBrush}" /></CheckBox>
                        <CheckBox Grid.Column="2" Classes="appraise-trait" IsChecked="{Binding RequireSparkling}"><TextBlock Text="Sparkling" Foreground="{Binding SparklingBrush}" /></CheckBox>
                        <CheckBox Grid.Column="4" Classes="appraise-trait" IsChecked="{Binding RequireTiny}"><TextBlock Text="Tiny" FontSize="11" Foreground="{Binding TinyBrush}" /></CheckBox>
                        <CheckBox Grid.Column="6" Classes="appraise-trait" IsChecked="{Binding RequireSmall}"><TextBlock Text="Small" FontSize="11" Foreground="{Binding SmallBrush}" /></CheckBox>
                        <CheckBox Grid.Column="8" Classes="appraise-trait" IsChecked="{Binding RequireBig}"><TextBlock Text="Big" FontSize="11" Foreground="{Binding BigBrush}" /></CheckBox>
                        <CheckBox Grid.Column="10" Classes="appraise-trait" IsChecked="{Binding RequireGiant}"><TextBlock Text="Giant" FontSize="11" Foreground="{Binding GiantBrush}" /></CheckBox>
                    </Grid>
                </Grid>

                <Border Grid.Row="5"
                        Background="{StaticResource Border}" />

                <Grid Grid.Row="6"
                      Margin="20,0"
                      IsVisible="{Binding IsGamepassMode}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="Roll Speed"
                                   Width="84"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <Slider Classes="appraise-speed"
                                Minimum="0"
                                Maximum="1"
                                Width="112"
                                VerticalAlignment="Center"
                                Value="{Binding GamepassSpeed}"
                                TickFrequency="0.05" />
                        <TextBlock Text="{Binding GamepassSpeedPercentText}"
                                   Width="30"
                                   VerticalAlignment="Center"
                                   TextAlignment="Left"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextPrimary}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="6"
                      Margin="20,0"
                      IsVisible="{Binding IsNormalMode}">
                    <Button
                            Classes="appraise-secondary"
                            Width="150"
                            Height="30"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="Set Click Position"
                            Command="{Binding UseCursorPositionCommand}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
