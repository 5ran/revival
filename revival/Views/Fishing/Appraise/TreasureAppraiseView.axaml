<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Client.ViewModels"
             x:Class="Client.Views.TreasureAppraiseView"
             x:DataType="vm:TreasureAppraiseViewModel"
             Background="{StaticResource Background}">
    <UserControl.Styles>
        <Style Selector="TextBox.treasure-input">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="21" />
            <Setter Property="Padding" Value="10,-1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Border Classes="app-card"
            Width="550"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="20,0">
        <Grid RowDefinitions="42,1,56">
            <CheckBox Grid.Row="0"
                      IsChecked="{Binding AutoTreasureEnabled}"
                      Content="Auto Tressure Appraise"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontFamily="{StaticResource DisplayFont}"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextPrimary}" />

            <Border Grid.Row="1"
                    Background="{StaticResource Border}" />

            <Grid Grid.Row="2"
                  ColumnDefinitions="145,15,1,15,145,15,1,15,145"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <StackPanel Grid.Column="0"
                            Spacing="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Click Delay (sec)"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextSecondary}" />
                    <TextBox Classes="app-input treasure-input"
                             Width="112"
                             HorizontalAlignment="Center"
                             HorizontalContentAlignment="Center"
                             Text="{Binding ClickDelaySecondsText}" />
                </StackPanel>

                <Border Grid.Column="2"
                        Background="{StaticResource Border}"
                        Margin="0,8" />

                <StackPanel Grid.Column="4"
                            Spacing="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Minimum Multi"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextSecondary}" />
                    <TextBox Classes="app-input treasure-input"
                             Width="112"
                             HorizontalAlignment="Center"
                             HorizontalContentAlignment="Center"
                             Text="{Binding TargetWeightText}"
                             PlaceholderText="0.00" />
                </StackPanel>

                <Border Grid.Column="6"
                        Background="{StaticResource Border}"
                        Margin="0,8" />

                <StackPanel Grid.Column="8"
                            Spacing="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Status"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding StatusText}"
                               Width="120"
                               Height="21"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
