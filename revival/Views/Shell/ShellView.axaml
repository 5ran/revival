<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Client.Views"
             xmlns:vm="using:Client.ViewModels"
             x:Class="Client.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Background="Transparent">
    <UserControl.Resources>
        <DataTemplate x:Key="NavigationItemTemplate"
                      DataType="{x:Type vm:ShellNavigationItemViewModel}">
            <Button Classes="nav-button"
                    Classes.selected="{Binding IsSelected}"
                    Foreground="{Binding Foreground}"
                    Command="{Binding NavigateCommand}">
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <Viewbox Width="18"
                             Height="18"
                             IsVisible="{Binding ShowsGeneralRodIcon}">
                        <Canvas Width="18" Height="18">
                            <Path Data="M 3 15 Q 5.5 7 13.5 3 M 13.5 3 C 15.2 4.6 15.4 7.1 14.8 9.3 C 14.1 11.6 12.5 12.8 10.7 12.5"
                                  Stroke="{Binding Foreground}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round"
                                  Fill="Transparent" />
                            <Ellipse Width="4.6"
                                     Height="4.6"
                                     Canvas.Left="2.4"
                                     Canvas.Top="11"
                                     Stroke="{Binding Foreground}"
                                     StrokeThickness="1.6"
                                     Fill="Transparent" />
                        </Canvas>
                    </Viewbox>

                    <Viewbox Width="18"
                             Height="18"
                             IsVisible="{Binding ShowsFishingGearRodIcon}">
                        <Canvas Width="28" Height="18">
                            <Path Data="M 14 15 Q 16.5 7 24.5 3 M 24.5 3 C 26.2 4.6 26.4 7.1 25.8 9.3 C 25.1 11.6 23.5 12.8 21.7 12.5"
                                  Stroke="{Binding Foreground}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round"
                                  Fill="Transparent" />
                            <Ellipse Width="4.6"
                                     Height="4.6"
                                     Canvas.Left="13.4"
                                     Canvas.Top="11"
                                     Stroke="{Binding Foreground}"
                                     StrokeThickness="1.6"
                                     Fill="Transparent" />
                            <Path Data="M 5 0.1 L 7 0.1 L 7.5 1.8 L 8.7 2.4 L 10.3 1.9 L 11.4 3.7 L 10.2 5 L 10.2 6.2 L 11.4 7.5 L 10.3 9.3 L 8.7 8.8 L 7.5 9.4 L 7 11.1 L 5 11.1 L 4.5 9.4 L 3.3 8.8 L 1.7 9.3 L 0.6 7.5 L 1.8 6.2 L 1.8 5 L 0.6 3.7 L 1.7 1.9 L 3.3 2.4 L 4.5 1.8 Z"
                                  Stroke="{Binding Foreground}"
                                  StrokeThickness="1.55"
                                  StrokeLineCap="Round"
                                  Fill="Transparent" />
                            <Ellipse Width="3.8"
                                     Height="3.8"
                                     Canvas.Left="4.1"
                                     Canvas.Top="3.7"
                                     Stroke="{Binding Foreground}"
                                     StrokeThickness="1.55"
                                     Fill="Transparent" />
                        </Canvas>
                    </Viewbox>

                    <Viewbox Width="18"
                             Height="18"
                             IsVisible="{Binding ShowsFishingAddonsIcon}">
                        <Canvas Width="28" Height="18">
                            <Path Data="M 14 15 Q 16.5 7 24.5 3 M 24.5 3 C 26.2 4.6 26.4 7.1 25.8 9.3 C 25.1 11.6 23.5 12.8 21.7 12.5"
                                  Stroke="{Binding Foreground}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round"
                                  Fill="Transparent" />
                            <Ellipse Width="4.6"
                                     Height="4.6"
                                     Canvas.Left="13.4"
                                     Canvas.Top="11"
                                     Stroke="{Binding Foreground}"
                                     StrokeThickness="1.6"
                                     Fill="Transparent" />
                            <Path Data="M 6 1 L 6 10.1 M 1.5 5.55 L 10.5 5.55"
                                  Stroke="{Binding Foreground}"
                                  StrokeThickness="2.2"
                                  StrokeLineCap="Round"
                                  Fill="Transparent" />
                        </Canvas>
                    </Viewbox>

                    <Viewbox Width="18"
                             Height="18"
                             IsVisible="{Binding ShowsAutomationIcon}">
                        <Canvas Width="18" Height="18">
                            <Path Data="M 7 1.5 L 8.2 6.8 L 13.5 8 L 8.2 9.2 L 7 14.5 L 5.8 9.2 L 0.5 8 L 5.8 6.8 Z M 14 9.5 L 14.7 12.3 L 17.5 13 L 14.7 13.7 L 14 16.5 L 13.3 13.7 L 10.5 13 L 13.3 12.3 Z"
                                  Stroke="{Binding Foreground}"
                                  StrokeThickness="1.5"
                                  StrokeLineCap="Round"
                                  Fill="Transparent" />
                        </Canvas>
                    </Viewbox>

                    <Viewbox Width="18"
                             Height="18"
                             IsVisible="{Binding ShowsAnglerIcon}">
                        <Canvas Width="18" Height="18">
                            <Path Data="M 4 2 L 4 10.3 C 4 13.4 6.1 15.5 9.1 15.5 C 12 15.5 14.2 13.4 14.2 10.8 C 14.2 8.8 12.9 7.4 11.2 7.4 C 9.7 7.4 8.6 8.5 8.6 9.8 C 8.6 11 9.4 11.8 10.5 11.8 M 2 4 L 6 4"
                                  Stroke="{Binding Foreground}"
                                  StrokeThickness="1.55"
                                  StrokeLineCap="Round"
                                  Fill="Transparent" />
                        </Canvas>
                    </Viewbox>

                    <Viewbox Width="18"
                             Height="18"
                             IsVisible="{Binding ShowsAppraiseIcon}">
                        <Canvas Width="18" Height="18">
                            <Path Data="M 5 1 L 13 1 L 17 5 L 17 13 L 13 17 L 5 17 L 1 13 L 1 5 Z M 8 6.7 C 7.4 6.3 6.7 6.1 6 6.1 C 4.6 6.1 3.7 7.2 3.7 9 C 3.7 10.8 4.6 11.9 6 11.9 C 6.7 11.9 7.4 11.7 8 11.3 M 11.8 5.5 L 11.8 12.5 M 14 6.8 C 13.5 6.4 12.8 6.1 12 6.1 C 10.9 6.1 10.2 6.6 10.2 7.4 C 10.2 8.2 10.8 8.5 12.1 8.8 C 13.4 9.1 14 9.5 14 10.3 C 14 11.2 13.2 11.9 12 11.9 C 11.2 11.9 10.5 11.6 9.9 11.2"
                                  Stroke="{Binding Foreground}"
                                  StrokeThickness="1.35"
                                  StrokeLineCap="Round"
                                  Fill="Transparent" />
                        </Canvas>
                    </Viewbox>

                    <Viewbox Width="18"
                             Height="18"
                             IsVisible="{Binding ShowsHuntDetectIcon}">
                        <Canvas Width="18" Height="18">
                            <Ellipse Width="12"
                                     Height="12"
                                     Canvas.Left="3"
                                     Canvas.Top="3"
                                     Stroke="{Binding Foreground}"
                                     StrokeThickness="1.5"
                                     Fill="Transparent" />
                            <Ellipse Width="4.5"
                                     Height="4.5"
                                     Canvas.Left="6.75"
                                     Canvas.Top="6.75"
                                     Stroke="{Binding Foreground}"
                                     StrokeThickness="1.5"
                                     Fill="Transparent" />
                            <Path Data="M 9 0.8 L 9 4.2 M 9 13.8 L 9 17.2 M 0.8 9 L 4.2 9 M 13.8 9 L 17.2 9"
                                  Stroke="{Binding Foreground}"
                                  StrokeThickness="1.5"
                                  StrokeLineCap="Round"
                                  Fill="Transparent" />
                        </Canvas>
                    </Viewbox>

                    <Viewbox Width="18"
                             Height="18"
                             IsVisible="{Binding ShowsEditIcon}">
                        <Canvas Width="18" Height="18">
                            <Path Data="M 2.5 13.7 L 3.2 10.8 L 11.4 2.6 Q 12.1 1.9 12.8 2.6 L 14.4 4.2 Q 15.1 4.9 14.4 5.6 L 6.2 13.8 L 3.3 14.5 Z M 10.5 3.5 L 13.5 6.5"
                                  Stroke="{Binding Foreground}"
                                  StrokeThickness="1.45"
                                  StrokeLineCap="Round"
                                  Fill="Transparent" />
                            <Path Data="M 10.5 11.2 L 10.5 13.2 M 13 9.8 L 13 14.6 M 15.5 11.2 L 15.5 13.2"
                                  Stroke="{Binding Foreground}"
                                  StrokeThickness="1.45"
                                  StrokeLineCap="Round"
                                  Fill="Transparent" />
                        </Canvas>
                    </Viewbox>

                    <TextBlock Text="{Binding Name}"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{Binding Foreground}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type vm:GeneralViewModel}">
            <views:GeneralView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FishingViewModel}">
            <views:FishingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FishingAddonsViewModel}">
            <views:FishingAddonsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OtherAutomationViewModel}">
            <views:OtherAutomationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnglerAutomationViewModel}">
            <views:AnglerAutomationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppraiseAutomationViewModel}">
            <views:AppraiseAutomationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AutoTotemViewModel}">
            <views:AutoTotemView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AutoSovereignRechargeViewModel}">
            <views:AutoSovereignRechargeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HuntDetectViewModel}">
            <views:HuntDetectView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AutoAnglerViewModel}">
            <views:AutoAnglerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppraiseViewModel}">
            <views:AppraiseView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TreasureAppraiseViewModel}">
            <views:TreasureAppraiseView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EnchantViewModel}">
            <views:EnchantView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompactViewModel}">
            <views:CompactView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <Style Selector="Button.nav-button">
            <Setter Property="Width" Value="186" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="24,0,18,0" />
            <Setter Property="Background" Value="{StaticResource ShellNavBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellContentBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Path Name="NavShadow"
                              Margin="2,3,0,0"
                              Stretch="Fill"
                              Fill="{StaticResource ShellShadow}"
                              Data="M 8 0 L 178 0 Q 186 0 186 8 L 186 46 Q 186 54 178 54 L 8 54 Q 0 54 0 46 L 0 8 Q 0 0 8 0 Z" />
                        <Path Name="NavGlow"
                              Stretch="Fill"
                              Fill="Transparent"
                              Stroke="#00000000"
                              StrokeThickness="5"
                              Data="M 8 0 L 178 0 Q 186 0 186 8 L 186 46 Q 186 54 178 54 L 8 54 Q 0 54 0 46 L 0 8 Q 0 0 8 0 Z" />
                        <Path Name="NavShape"
                              Stretch="Fill"
                              Fill="{TemplateBinding Background}"
                              Stroke="{TemplateBinding BorderBrush}"
                              StrokeThickness="1"
                              Data="M 8 0 L 178 0 Q 186 0 186 8 L 186 46 Q 186 54 178 54 L 8 54 Q 0 54 0 46 L 0 8 Q 0 0 8 0 Z" />
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.nav-button /template/ Path#NavShape">
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
        </Style>

        <Style Selector="Button.nav-button:pointerover /template/ Path#NavShape">
            <Setter Property="Fill" Value="{StaticResource ShellNavHoverBackground}" />
            <Setter Property="Stroke" Value="{StaticResource ShellNavHoverBorder}" />
        </Style>

        <Style Selector="Button.nav-button:pointerover">
            <Setter Property="Foreground" Value="{StaticResource SidebarItemHoverForeground}" />
        </Style>

        <Style Selector="Button.nav-button">
            <Setter Property="RenderTransform">
                <TranslateTransform X="-12" />
            </Setter>
        </Style>

        <Style Selector="Button.nav-button.selected">
            <Setter Property="Panel.ZIndex" Value="10" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="RenderTransform">
                <TranslateTransform X="-28" />
            </Setter>
        </Style>

        <Style Selector="ItemsControl.nav-underlay Button.nav-button.selected">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="Grid.selected-overlay Button.nav-button.selected">
            <Setter Property="RenderTransform">
                <TranslateTransform X="0" />
            </Setter>
        </Style>

        <Style Selector="Button.nav-button.selected /template/ Path#NavShape">
            <Setter Property="Data" Value="M 16 0 L 179 0 Q 186 0 186 7 L 186 47 Q 186 54 179 54 L 16 54 L 0 27 Z" />
            <Setter Property="Fill" Value="{StaticResource ShellNavSelectedBackground}" />
            <Setter Property="Stroke" Value="{StaticResource ShellNavSelectedBorder}" />
            <Setter Property="StrokeThickness" Value="1.5" />
        </Style>

        <Style Selector="Button.nav-button.selected /template/ Path#NavShadow">
            <Setter Property="Data" Value="M 16 0 L 179 0 Q 186 0 186 7 L 186 47 Q 186 54 179 54 L 16 54 L 0 27 Z" />
            <Setter Property="Fill" Value="{StaticResource ShellSelectedShadow}" />
            <Setter Property="Margin" Value="4,5,0,0" />
        </Style>

        <Style Selector="Button.nav-button.selected /template/ Path#NavGlow">
            <Setter Property="Data" Value="M 16 0 L 179 0 Q 186 0 186 7 L 186 47 Q 186 54 179 54 L 16 54 L 0 27 Z" />
            <Setter Property="Stroke" Value="{StaticResource ShellNavGlow}" />
            <Setter Property="StrokeThickness" Value="6" />
        </Style>

        <Style Selector="Button.edit-tag">
            <Setter Property="Width" Value="78" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0,0,0,8" />
            <Setter Property="Background" Value="{StaticResource ShellNavBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellContentBorder}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Path Name="EditTagShadow"
                              Margin="2,3,0,0"
                              Stretch="Fill"
                              Fill="{StaticResource ShellShadow}"
                              Data="M 3 0 L 75 0 Q 78 0 78 3 L 78 17 Q 78 19 76.5 20.5 L 70.5 26.5 Q 69 28 66.5 28 L 11.5 28 Q 9 28 7.5 26.5 L 1.5 20.5 Q 0 19 0 17 L 0 3 Q 0 0 3 0 Z" />
                        <Path Name="EditTagShape"
                              Stretch="Fill"
                              Fill="{TemplateBinding Background}"
                              Stroke="{TemplateBinding BorderBrush}"
                              StrokeThickness="1"
                              Data="M 3 0 L 75 0 Q 78 0 78 3 L 78 17 Q 78 19 76.5 20.5 L 70.5 26.5 Q 69 28 66.5 28 L 11.5 28 Q 9 28 7.5 26.5 L 1.5 20.5 Q 0 19 0 17 L 0 3 Q 0 0 3 0 Z" />
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.edit-tag:pointerover /template/ Path#EditTagShape">
            <Setter Property="Fill" Value="{StaticResource ShellNavHoverBackground}" />
            <Setter Property="Stroke" Value="{StaticResource ShellNavHoverBorder}" />
        </Style>

        <Style Selector="Button.edit-tag.selected /template/ Path#EditTagShape">
            <Setter Property="Fill" Value="{StaticResource ShellNavSelectedBackground}" />
            <Setter Property="Stroke" Value="{StaticResource ShellNavSelectedBorder}" />
            <Setter Property="StrokeThickness" Value="1.5" />
        </Style>
    </UserControl.Styles>

    <Grid Background="Transparent">
        <ContentControl Content="{Binding CompactViewModel}"
                        IsVisible="{Binding IsCompactMode}" />

        <Grid IsVisible="{Binding !IsCompactMode}"
              Background="Transparent">
            <Border Margin="3"
                    CornerRadius="13"
                    BorderBrush="{StaticResource ShellOuterBorder}"
                    BorderThickness="3"
                    Background="{StaticResource ShellBackground}">
            </Border>

            <Border Margin="6"
                    CornerRadius="10"
                    BorderBrush="{StaticResource ShellInnerBorder}"
                    BorderThickness="1"
                    Background="Transparent" />

            <TextBlock Margin="24,14,0,0"
                       Text="REVIVAL"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" />

            <Border Margin="20,42,190,20"
                    ZIndex="10"
                    CornerRadius="8"
                    BorderBrush="{StaticResource ShellContentBorder}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    Background="{StaticResource ShellContentBackground}">
                <Grid Background="{StaticResource Background}">
                    <ContentControl Content="{Binding CurrentPage}" />
                </Grid>
            </Border>

            <Button Classes="edit-tag"
                    Classes.selected="{Binding EditNavigationItem.IsSelected}"
                    Margin="0,25,218,0"
                    ZIndex="9"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Foreground="{Binding EditNavigationItem.Foreground}"
                    Command="{Binding EditNavigationItem.NavigateCommand}">
                <StackPanel Orientation="Horizontal"
                            Spacing="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Viewbox Width="12"
                             Height="12">
                        <Canvas Width="18" Height="18">
                            <Path Data="M 2.5 13.7 L 3.2 10.8 L 11.4 2.6 Q 12.1 1.9 12.8 2.6 L 14.4 4.2 Q 15.1 4.9 14.4 5.6 L 6.2 13.8 L 3.3 14.5 Z M 10.5 3.5 L 13.5 6.5"
                                  Stroke="{Binding EditNavigationItem.Foreground}"
                                  StrokeThickness="1.45"
                                  StrokeLineCap="Round"
                                  Fill="Transparent" />
                            <Path Data="M 10.5 11.2 L 10.5 13.2 M 13 9.8 L 13 14.6 M 15.5 11.2 L 15.5 13.2"
                                  Stroke="{Binding EditNavigationItem.Foreground}"
                                  StrokeThickness="1.45"
                                  StrokeLineCap="Round"
                                  Fill="Transparent" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Edit"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{Binding EditNavigationItem.Foreground}" />
                </StackPanel>
            </Button>

            <Button Classes="edit-tag"
                    Classes.selected="{Binding HuntDetectNavigationItem.IsSelected}"
                    Width="92"
                    Margin="0,25,300,0"
                    ZIndex="9"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Foreground="{Binding HuntDetectNavigationItem.Foreground}"
                    Command="{Binding HuntDetectNavigationItem.NavigateCommand}">
                <StackPanel Orientation="Horizontal"
                            Spacing="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Viewbox Width="12"
                             Height="12">
                        <Canvas Width="18" Height="18">
                            <Ellipse Width="12"
                                     Height="12"
                                     Canvas.Left="3"
                                     Canvas.Top="3"
                                     Stroke="{Binding HuntDetectNavigationItem.Foreground}"
                                     StrokeThickness="1.5"
                                     Fill="Transparent" />
                            <Ellipse Width="4.5"
                                     Height="4.5"
                                     Canvas.Left="6.75"
                                     Canvas.Top="6.75"
                                     Stroke="{Binding HuntDetectNavigationItem.Foreground}"
                                     StrokeThickness="1.5"
                                     Fill="Transparent" />
                            <Path Data="M 9 0.8 L 9 4.2 M 9 13.8 L 9 17.2 M 0.8 9 L 4.2 9 M 13.8 9 L 17.2 9"
                                  Stroke="{Binding HuntDetectNavigationItem.Foreground}"
                                  StrokeThickness="1.5"
                                  StrokeLineCap="Round"
                                  Fill="Transparent" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Hunt Detect"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{Binding HuntDetectNavigationItem.Foreground}" />
                </StackPanel>
            </Button>

            <ItemsControl x:Name="NavRail"
                          Classes="nav-underlay"
                          Width="186"
                          Margin="0,26,8,0"
                          ZIndex="5"
                          ClipToBounds="False"
                          Background="Transparent"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding MainNavigationItems}"
                          ItemTemplate="{StaticResource NavigationItemTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel ClipToBounds="False" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Grid Width="186"
                  Classes="selected-overlay"
                  Height="300"
                  Margin="0,26,20,0"
                  ZIndex="20"
                  ClipToBounds="False"
                  IsVisible="{Binding IsMainNavigationSelected}"
                  IsHitTestVisible="False"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center">
                <ContentControl Content="{Binding SelectedNavigationItem}"
                                ContentTemplate="{StaticResource NavigationItemTemplate}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                    <ContentControl.RenderTransform>
                        <TranslateTransform Y="{Binding SelectedNavigationOffset}" />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
