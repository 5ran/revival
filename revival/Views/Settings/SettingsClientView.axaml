<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Client.Views"
             xmlns:vm="using:Client.ViewModels"
             x:Class="Client.Views.SettingsClientView"
             x:DataType="vm:SettingsClientViewModel"
             Background="Transparent">
    <UserControl.Styles>
        <Style Selector="Button.theme-card-btn /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.theme-open-btn">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="{StaticResource AccentForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.theme-open-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentHover}" />
        </Style>
        <Style Selector="Button.theme-open-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentPressed}" />
        </Style>
        <Style Selector="Border.theme-card">
            <Setter Property="Background" Value="{StaticResource Surface}" />
        </Style>
        <Style Selector="Button.theme-card-btn:pointerover Border.theme-card">
            <Setter Property="Background" Value="{StaticResource ThemeCardHoverBackground}" />
        </Style>
        <Style Selector="Button.theme-card-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.theme-card-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <local:BoolToBorderBrushConverter x:Key="BoolToBorderBrush" />
    </UserControl.Resources>

    <StackPanel Spacing="12">
        <StackPanel>
            <TextBlock Text="Theme"
                       Classes="tab-section-title"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,2,0,2" />
            <Rectangle Height="1"
                       Fill="{StaticResource Border}"
                       Margin="0,8,0,0" />

            <Grid ColumnDefinitions="*,*,*,*"
                  RowDefinitions="Auto,10,Auto"
                  ColumnSpacing="8"
                  Margin="0,10,0,0">
                <!-- Dark card -->
                <Button Grid.Row="0"
                        Grid.Column="0"
                        Classes="theme-card-btn"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Cursor="Hand"
                        Command="{Binding SelectDarkCommand}">
                    <Border Height="54"
                            Classes="theme-card"
                            CornerRadius="6"
                            BorderThickness="1.5"
                            BorderBrush="{Binding IsDarkSelected, Converter={StaticResource BoolToBorderBrush}}">
                        <TextBlock Text="Dark"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                    </Border>
                </Button>

                <!-- Light card -->
                <Button Grid.Row="0"
                        Grid.Column="1"
                        Classes="theme-card-btn"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Cursor="Hand"
                        Command="{Binding SelectLightCommand}">
                    <Border Height="54"
                            Classes="theme-card"
                            CornerRadius="6"
                            BorderThickness="1.5"
                            BorderBrush="{Binding IsLightSelected, Converter={StaticResource BoolToBorderBrush}}">
                        <TextBlock Text="Light"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                    </Border>
                </Button>

                <!-- Blue card -->
                <Button Grid.Row="0"
                        Grid.Column="2"
                        Classes="theme-card-btn"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Cursor="Hand"
                        Command="{Binding SelectSlateCommand}">
                    <Border Height="54"
                            Classes="theme-card"
                            CornerRadius="6"
                            BorderThickness="1.5"
                            BorderBrush="{Binding IsSlateSelected, Converter={StaticResource BoolToBorderBrush}}">
                        <TextBlock Text="Blue"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                    </Border>
                </Button>

                <!-- Pink card -->
                <Button Grid.Row="0"
                        Grid.Column="3"
                        Classes="theme-card-btn"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Cursor="Hand"
                        Command="{Binding SelectPinkCommand}">
                    <Border Height="54"
                            Classes="theme-card"
                            CornerRadius="6"
                            BorderThickness="1.5"
                            BorderBrush="{Binding IsPinkSelected, Converter={StaticResource BoolToBorderBrush}}">
                        <TextBlock Text="Pink"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                    </Border>
                </Button>

                <!-- Custom card -->
                <Border Grid.Row="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Width="114"
                        Height="54"
                        Classes="theme-card"
                        CornerRadius="6"
                        BorderThickness="1.5"
                        BorderBrush="{Binding IsCustomCardActive, Converter={StaticResource BoolToBorderBrush}}"
                        HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="5">
                        <TextBlock Text="Custom"
                                   HorizontalAlignment="Center"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <Button Classes="theme-open-btn"
                                Content="{Binding CustomEditorButtonText}"
                                Command="{Binding ToggleCustomEditorCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsCustomEditorOpen}"
                    HorizontalAlignment="Center">
            <Rectangle Height="1"
                       Fill="{StaticResource Border}"
                       Width="364"
                       HorizontalAlignment="Center" />

            <Grid Margin="0,10,0,0"
                  Width="364"
                  HorizontalAlignment="Center"
                  ColumnDefinitions="72,1,72,1,72,1,72,1,72"
                  RowDefinitions="Auto">
                <Grid.Styles>
                    <Style Selector="StackPanel.color-option">
                        <Setter Property="HorizontalAlignment" Value="Center" />
                    </Style>
                    <Style Selector="Button.color-swatch-btn">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                    </Style>
                    <Style Selector="TextBlock.color-label">
                        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="TextAlignment" Value="Center" />
                        <Setter Property="Width" Value="72" />
                    </Style>
                    <Style Selector="Button.color-swatch-btn /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="Button.color-swatch-btn:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="Button.color-swatch-btn:pressed /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="Border.color-swatch">
                        <Setter Property="Width" Value="30" />
                        <Setter Property="Height" Value="30" />
                        <Setter Property="CornerRadius" Value="15" />
                        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                        <Setter Property="BorderThickness" Value="1" />
                    </Style>
                    <Style Selector="Button.color-swatch-btn:pointerover Border.color-swatch">
                        <Setter Property="BorderBrush" Value="{StaticResource TextSecondary}" />
                    </Style>
                </Grid.Styles>

                <StackPanel Grid.Column="0"
                            Classes="color-option"
                            Spacing="8"
                            Width="72">
                    <TextBlock Classes="color-label"
                               Text="Text" />
                    <Button Classes="color-swatch-btn">
                        <Border Classes="color-swatch" Background="{Binding TextPrimarySwatch}" />
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <Border Background="{StaticResource Surface}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10">
                                    <ColorView Color="{Binding TextPrimaryColor, Mode=TwoWay}"
                                               SelectedIndex="0"
                                               ColorSpectrumShape="Ring"
                                               IsColorPaletteVisible="False"
                                               IsColorComponentsVisible="False"
                                               IsColorModelVisible="False"
                                               IsHexInputVisible="False"
                                               IsColorPreviewVisible="False"
                                               IsAccentColorsVisible="False"
                                               IsAlphaVisible="False"
                                               IsComponentSliderVisible="False"
                                               IsComponentTextInputVisible="False"
                                               IsColorSpectrumVisible="True"
                                               IsColorSpectrumSliderVisible="True" />
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="1"
                        HorizontalAlignment="Center"
                        Background="{StaticResource Border}" />

                <StackPanel Grid.Column="2"
                            Classes="color-option"
                            Spacing="8"
                            Width="72">
                    <TextBlock Classes="color-label"
                               Text="Surface" />
                    <Button Classes="color-swatch-btn">
                        <Border Classes="color-swatch" Background="{Binding SurfaceSwatch}" />
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <Border Background="{StaticResource Surface}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10">
                                    <ColorView Color="{Binding SurfaceColor, Mode=TwoWay}"
                                               SelectedIndex="0"
                                               ColorSpectrumShape="Ring"
                                               IsColorPaletteVisible="False"
                                               IsColorComponentsVisible="False"
                                               IsColorModelVisible="False"
                                               IsHexInputVisible="False"
                                               IsColorPreviewVisible="False"
                                               IsAccentColorsVisible="False"
                                               IsAlphaVisible="False"
                                               IsComponentSliderVisible="False"
                                               IsComponentTextInputVisible="False"
                                               IsColorSpectrumVisible="True"
                                               IsColorSpectrumSliderVisible="True" />
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <Border Grid.Column="3"
                        Width="1"
                        HorizontalAlignment="Center"
                        Background="{StaticResource Border}" />

                <StackPanel Grid.Column="4"
                            Classes="color-option"
                            Spacing="8"
                            Width="72">
                    <TextBlock Classes="color-label"
                               Text="Background" />
                    <Button Classes="color-swatch-btn">
                        <Border Classes="color-swatch" Background="{Binding BackgroundSwatch}" />
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <Border Background="{StaticResource Surface}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10">
                                    <ColorView Color="{Binding BackgroundColor, Mode=TwoWay}"
                                               SelectedIndex="0"
                                               ColorSpectrumShape="Ring"
                                               IsColorPaletteVisible="False"
                                               IsColorComponentsVisible="False"
                                               IsColorModelVisible="False"
                                               IsHexInputVisible="False"
                                               IsColorPreviewVisible="False"
                                               IsAccentColorsVisible="False"
                                               IsAlphaVisible="False"
                                               IsComponentSliderVisible="False"
                                               IsComponentTextInputVisible="False"
                                               IsColorSpectrumVisible="True"
                                               IsColorSpectrumSliderVisible="True" />
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <Border Grid.Column="5"
                        Width="1"
                        HorizontalAlignment="Center"
                        Background="{StaticResource Border}" />

                <StackPanel Grid.Column="6"
                            Classes="color-option"
                            Spacing="8"
                            Width="72">
                    <TextBlock Classes="color-label"
                               Text="Border" />
                    <Button Classes="color-swatch-btn">
                        <Border Classes="color-swatch" Background="{Binding BorderSwatch}" />
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <Border Background="{StaticResource Surface}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10">
                                    <ColorView Color="{Binding BorderColor, Mode=TwoWay}"
                                               SelectedIndex="0"
                                               ColorSpectrumShape="Ring"
                                               IsColorPaletteVisible="False"
                                               IsColorComponentsVisible="False"
                                               IsColorModelVisible="False"
                                               IsHexInputVisible="False"
                                               IsColorPreviewVisible="False"
                                               IsAccentColorsVisible="False"
                                               IsAlphaVisible="False"
                                               IsComponentSliderVisible="False"
                                               IsComponentTextInputVisible="False"
                                               IsColorSpectrumVisible="True"
                                               IsColorSpectrumSliderVisible="True" />
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <Border Grid.Column="7"
                        Width="1"
                        HorizontalAlignment="Center"
                        Background="{StaticResource Border}" />

                <StackPanel Grid.Column="8"
                            Classes="color-option"
                            Spacing="8"
                            Width="72">
                    <TextBlock Classes="color-label"
                               Text="Accent" />
                    <Button Classes="color-swatch-btn">
                        <Border Classes="color-swatch" Background="{Binding AccentSwatch}" />
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <Border Background="{StaticResource Surface}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10">
                                    <ColorView Color="{Binding AccentColor, Mode=TwoWay}"
                                               SelectedIndex="0"
                                               ColorSpectrumShape="Ring"
                                               IsColorPaletteVisible="False"
                                               IsColorComponentsVisible="False"
                                               IsColorModelVisible="False"
                                               IsHexInputVisible="False"
                                               IsColorPreviewVisible="False"
                                               IsAccentColorsVisible="False"
                                               IsAlphaVisible="False"
                                               IsComponentSliderVisible="False"
                                               IsComponentTextInputVisible="False"
                                               IsColorSpectrumVisible="True"
                                               IsColorSpectrumSliderVisible="True" />
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
