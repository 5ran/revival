<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Client.Views"
             xmlns:vm="using:Client.ViewModels"
             x:Class="Client.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{StaticResource Background}">
    <UserControl.Styles>
        <Style Selector="Slider.interface-sound">
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Slider.interface-sound /template/ Track#PART_Track">
            <Setter Property="Height" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Slider.interface-sound /template/ Thumb">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
        </Style>
        <Style Selector="Slider.interface-sound /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="{StaticResource AccentHover}" />
        </Style>
        <Style Selector="Slider.interface-sound:pointerover /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Slider.interface-sound /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryBorder}" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Slider.interface-sound /template/ Thumb /template/ Ellipse">
            <Setter Property="Fill" Value="{StaticResource Accent}" />
            <Setter Property="Stroke" Value="{StaticResource AccentHover}" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
    </UserControl.Styles>
    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type vm:SettingsClientViewModel}">
            <views:SettingsClientView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  VerticalContentAlignment="Center"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Width="550"
              Margin="0,16,0,12"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RowDefinitions="Auto,Auto">
            <StackPanel Grid.Row="0"
                        Spacing="12"
                        HorizontalAlignment="Center">
                <Border Classes="app-card"
                        Width="550"
                        Padding="18,16">
                    <ContentControl Content="{Binding ClientSettings}" />
                </Border>

                <Border Classes="app-card"
                        Width="550"
                        Padding="18,16">
                    <StackPanel Width="480"
                                Spacing="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="Interface Sounds"
                                   Classes="tab-section-title"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <Border Height="1"
                                Background="{StaticResource Border}" />
                        <Grid RowDefinitions="Auto,Auto"
                              RowSpacing="12"
                              HorizontalAlignment="Center">
                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Enable Interface Sounds"
                                           Width="150"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           FontFamily="{StaticResource UIFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextPrimary}" />
                                <ToggleSwitch IsChecked="{Binding InterfaceSoundsEnabled}"
                                              VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Interface Sound Volume"
                                           Width="150"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" />
                                <Slider Classes="interface-sound"
                                        Minimum="0"
                                        Maximum="100"
                                        Width="112"
                                        VerticalAlignment="Center"
                                        Value="{Binding InterfaceSoundVolume}" />
                                <TextBlock Text="{Binding InterfaceSoundVolume, StringFormat={}{0:0}%}"
                                           Width="34"
                                           VerticalAlignment="Center"
                                           TextAlignment="Left"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextPrimary}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Margin="0,8,0,0"
                       Text="{Binding AppVersionText}"
                       HorizontalAlignment="Right"
                       FontFamily="{StaticResource UIFont}"
                       FontSize="11"
                       Foreground="{StaticResource TextSecondary}" />
        </Grid>
    </ScrollViewer>
</UserControl>
