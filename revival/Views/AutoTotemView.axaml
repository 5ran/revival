<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Client.ViewModels"
             xmlns:controls="using:Client.Controls"
             x:Class="Client.Views.AutoTotemView"
             x:DataType="vm:AutoTotemViewModel"
             Background="{StaticResource Background}">
    <UserControl.Styles>
        <Style Selector="TextBlock.section-label">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>
        <Style Selector="CheckBox.totem-check">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style Selector="TextBlock.totem-inline">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style Selector="Border.standalone-totem-picker">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Button.standalone-totem-picker-button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="CornerRadius" Value="0,6,6,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.standalone-totem-picker-button:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentHover}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentHover}" />
        </Style>
        <Style Selector="Button.standalone-totem-picker-button:pressed">
            <Setter Property="Background" Value="{StaticResource AccentPressed}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentPressed}" />
        </Style>
        <Style Selector="Border.standalone-totem-dropdown-surface">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="ListBox.standalone-totem-dropdown">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.standalone-totem-dropdown ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.standalone-totem-dropdown ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ListBox.standalone-totem-dropdown ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource InputHoverSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="ListBox.standalone-totem-dropdown ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ToggleCheckedBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource ToggleCheckedBorder}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*"
          Margin="34,0,34,34">
        <Border Grid.Row="0"
                Classes="app-card"
                Padding="14">
            <StackPanel Spacing="10">
            <StackPanel Spacing="5">
                <TextBlock Classes="section-label" Text="Totem" />
                <Panel Width="213">
                    <Border x:Name="StandaloneTotemPicker"
                            Classes="standalone-totem-picker"
                            Height="38">
                        <Grid ColumnDefinitions="*,56">
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="0"
                                        Margin="12,0,8,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedTotem.DisplayPrimary}"
                                           FontFamily="{StaticResource UIFont}"
                                           FontSize="12"
                                           Foreground="{Binding SelectedTotem.Brush}" />
                                <TextBlock Text="{Binding SelectedTotem.DisplaySuffix}"
                                           FontFamily="{StaticResource UIFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextPrimary}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="standalone-totem-picker-button"
                                    Click="StandaloneTotemDropdownButton_OnClick">
                                <Path Width="10"
                                      Height="6"
                                      Stretch="Fill"
                                      Fill="{StaticResource AccentForeground}"
                                      Data="M 0 0 L 5 6 L 10 0 Z" />
                            </Button>
                        </Grid>
                    </Border>
                    <Popup x:Name="StandaloneTotemDropdownPopup"
                           PlacementTarget="{Binding #StandaloneTotemPicker}"
                           Placement="AnchorAndGravity"
                           PlacementAnchor="BottomLeft"
                           PlacementGravity="BottomRight"
                           IsLightDismissEnabled="True">
                        <Border Classes="standalone-totem-dropdown-surface"
                                Width="{Binding #StandaloneTotemPicker.Bounds.Width, Converter={StaticResource ScaledPopupWidthConverter}}"
                                Margin="0,4,0,0">
                            <ScrollViewer MaxHeight="220"
                                          VerticalScrollBarVisibility="Auto">
                                <ListBox Classes="standalone-totem-dropdown"
                                         ItemsSource="{Binding TotemOptions}"
                                         SelectedItem="{Binding SelectedTotem}"
                                         SelectionChanged="StandaloneTotemList_OnSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TotemOptionViewModel">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="0"
                                                        Margin="8,6">
                                                <TextBlock Text="{Binding DisplayPrimary}"
                                                           FontFamily="{StaticResource UIFont}"
                                                           FontSize="12"
                                                           Foreground="{Binding Brush}" />
                                                <TextBlock Text="{Binding DisplaySuffix}"
                                                           FontFamily="{StaticResource UIFont}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextPrimary}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Panel>
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Classes="section-label" Text="Shiny / Sparkling / Mutation" />
                <Grid ColumnDefinitions="*,*,*"
                      ColumnSpacing="10">
                    <Border Grid.Column="0"
                            Classes="app-card"
                            Padding="8,10">
                        <CheckBox Classes="totem-check"
                                  IsChecked="{Binding UseShinyTotem}">
                            <CheckBox.Content>
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <TextBlock Text="Use "
                                               Classes="totem-inline" />
                                    <TextBlock Text="Shiny"
                                               Classes="totem-inline"
                                               Foreground="#FFF5B4" />
                                    <TextBlock Text=" Totem"
                                               Classes="totem-inline" />
                                </StackPanel>
                            </CheckBox.Content>
                        </CheckBox>
                    </Border>
                    <Border Grid.Column="1"
                            Classes="app-card"
                            Padding="8,10">
                        <CheckBox Classes="totem-check"
                                  IsChecked="{Binding UseSparklingTotem}">
                            <CheckBox.Content>
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <TextBlock Text="Use "
                                               Classes="totem-inline" />
                                    <TextBlock Text="Sparkling"
                                               Classes="totem-inline"
                                               Foreground="#FFF0AA" />
                                    <TextBlock Text=" Totem"
                                               Classes="totem-inline" />
                                </StackPanel>
                            </CheckBox.Content>
                        </CheckBox>
                    </Border>
                    <Border Grid.Column="2"
                            Classes="app-card"
                            Padding="8,10">
                        <CheckBox Classes="totem-check"
                                  IsChecked="{Binding UseMutationTotem}">
                            <CheckBox.Content>
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <TextBlock Text="Use "
                                               Classes="totem-inline" />
                                    <TextBlock Text="Mutation"
                                               Classes="totem-inline"
                                               Foreground="#78FF78" />
                                    <TextBlock Text=" Totem"
                                               Classes="totem-inline" />
                                </StackPanel>
                            </CheckBox.Content>
                        </CheckBox>
                    </Border>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="5">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="8">
                    <TextBlock Grid.Column="0"
                               Classes="section-label"
                               Text="Cycle Lock" />
                    <TextBlock Grid.Column="1"
                               IsVisible="{Binding !IsTimePreferenceEditable}"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondary}"
                               Text="Locked by Totem" />
                </Grid>
                <Grid ColumnDefinitions="*,*,*"
                      ColumnSpacing="10">
                    <Border Grid.Column="0"
                            Classes="app-card"
                            Padding="8,10">
                        <CheckBox Classes="totem-check"
                                  Content="Stay Day"
                                  IsEnabled="{Binding IsTimePreferenceEditable}"
                                  IsChecked="{Binding StayDay}" />
                    </Border>
                    <Border Grid.Column="1"
                            Classes="app-card"
                            Padding="8,10">
                        <CheckBox Classes="totem-check"
                                  Content="Stay Night"
                                  IsEnabled="{Binding IsTimePreferenceEditable}"
                                  IsChecked="{Binding StayNight}" />
                    </Border>
                </Grid>
            </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,8,0,0"
              ColumnDefinitions="*">
            <Border Classes="app-card"
                    Height="122"
                    VerticalAlignment="Top"
                    Padding="18,16"
                    >
                <StackPanel Spacing="8">
                    <TextBlock Text="Status"
                               Classes="section-label" />
                    <controls:ColoredTextBlock Lines="{Binding StatusLines}"
                                               TextWrapping="Wrap"
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
