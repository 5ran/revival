<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:Client.Views"
        xmlns:vm="using:Client.ViewModels"
        mc:Ignorable="d"
        x:Class="Client.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="OpenMacro"
        Icon="/Assets/OpenMacro-Logo.ico"
        Width="820"
        Height="480"
        Topmost="True"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None">
    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:ShellViewModel}">
            <views:ShellView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <Style Selector="Button.chrome-button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="{StaticResource ShellChromeBackground}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellChromeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.chrome-button:pointerover">
            <Setter Property="Background" Value="{StaticResource InputHoverSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style Selector="Button.chrome-status-action">
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellChromeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>
    </Window.Styles>

    <Grid Background="Transparent">
        <ContentControl Content="{Binding CurrentView}" />

        <Grid x:Name="TitleBar"
              Margin="24,10,8,0"
              Height="32"
              VerticalAlignment="Top"
              IsHitTestVisible="True"
              PointerPressed="TitleBar_OnPointerPressed"
              ColumnDefinitions="*,Auto">
            <ContentControl Grid.Column="0"
                            Content="{Binding CurrentView}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:ShellViewModel}"
                                  x:DataType="vm:ShellViewModel">
                        <Grid ColumnDefinitions="Auto,Auto,Auto"
                              VerticalAlignment="Center"
                              IsVisible="{Binding IsRobloxBannerVisible}"
                              ToolTip.Tip="{Binding RobloxBannerSubtext}">
                            <Ellipse Grid.Column="0"
                                     Width="5"
                                     Height="5"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource TextSecondary}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding RobloxBannerTitle}"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource UIFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondary}" />
                            <Button Grid.Column="2"
                                    Classes="chrome-status-action"
                                    Content="Fix"
                                    Command="{Binding RobloxFixGuideCommand}"
                                    IsVisible="{Binding IsRobloxFixButtonVisible}" />
                        </Grid>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,-6,0,0">
                <Button x:Name="MinimizeButton"
                        Classes="chrome-button"
                        Click="MinimizeButton_OnClick">
                    &#x2212;
                </Button>
                <Button x:Name="CloseButton"
                        Classes="chrome-button"
                        Click="CloseButton_OnClick">
                    &#x00D7;
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
